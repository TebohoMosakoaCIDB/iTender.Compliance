@rendermode InteractiveServer

@using Microsoft.AspNetCore.SignalR.Client
@using iTender.Compliance.Application.DTOs
@using iTender.Compliance.Application.Interfaces.Services
@using Microsoft.AspNetCore.Components.Authorization

@implements IAsyncDisposable

@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <div class="dropdown notification-wrapper">

            <button type="button"
                    class="btn btn-link position-relative notification-button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">

                <i class="bi bi-bell-fill fs-5"></i>

                @if (UnreadCount > 0)
                {
                    <span class="notification-badge badge rounded-pill bg-danger">
                        @UnreadCount
                    </span>
                }

            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow notification-dropdown">

                @if (Notifications.Any())
                {
                    @foreach (var notification in Notifications)
                    {
                        <li class="notification-list-item">

                            <a class="notification-item"
                               href="/notifications/@notification.Id">

                                <div class="notification-content">

                                    <div class="notification-title">
                                        @notification.Title
                                    </div>

                                    <div class="notification-message">
                                        @notification.Message
                                    </div>

                                </div>

                            </a>

                        </li>

                        <li>
                            <hr class="dropdown-divider" />
                        </li>
                    }

                    <li>
                        <a class="dropdown-item text-center"
                           href="/notifications">
                            View All Notifications
                        </a>
                    </li>
                }
                else
                {
                    <li>
                        <span class="dropdown-item text-muted">
                            No notifications
                        </span>
                    </li>
                }

            </ul>

        </div>
    </Authorized>
</AuthorizeView>

@code {
    private List<NotificationModel> Notifications = [];

    private int UnreadCount;

    private bool _loaded;

    private HubConnection? _hubConnection;

    private Guid _userId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        await Task.Delay(2000);
        _loaded = true;

        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (!(auth.User.Identity?.IsAuthenticated ?? false))
            return;

        var id = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);

        if (id is null)
            return;

        _userId = Guid.Parse(id.Value);

        Notifications = await NotificationService.GetRecentAsync(_userId);
        UnreadCount = await NotificationService.GetUnreadCountAsync(_userId);

        // Wire up SignalR so new notifications appear without a page refresh.
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/notifications"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On("NotificationReceived", async () =>
            {
                if (_userId == Guid.Empty)
                    return;

                Notifications = await NotificationService.GetRecentAsync(_userId);
                UnreadCount = await NotificationService.GetUnreadCountAsync(_userId);

                await InvokeAsync(StateHasChanged);
            });

            await _hubConnection.StartAsync();
        }
        catch
        {
            // SignalR is best-effort - if it fails, the user still sees
            // notifications on the next page load.
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
            _hubConnection = null;
        }
    }
}