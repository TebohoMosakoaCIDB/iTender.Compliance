@page "/cases/{Id:guid}"

@using iTender.Compliance.Client.Helpers
@using iTender.Compliance.Application.DTOs
@using iTender.Compliance.Domain.Enums
@using iTender.Compliance.Domain.Entities
@using iTender.Compliance.Application.Interfaces.Repositories
@using iTender.Compliance.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICorrespondenceService CorrespondenceService

@inject IComplianceCaseRepository Repository
@inject IAgentRepository AgentRepository
@inject IComplianceService ComplianceService
@inject ICaseNoteRepository CaseNoteRepository
@inject ISystemSettingService SystemSettingService

@inject IAuthorizationService AuthorizationService

@inject IJSRuntime JS

@rendermode InteractiveServer

@attribute [Authorize(Policy = "CaseManagement")]

<PageTitle>Compliance Cases | CRCIP Monitor</PageTitle>

<h2 class="mb-5">
    <i class="bi bi-folder-check me-2 text-secondary"></i>
    Compliance Case
</h2>

@if (Model == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row mb-4">
        <div class="col-9">
            <div class="d-flex justify-content-between align-items-start mb-2">

                <div>

                    <h3 class="mb-1">
                        @Model.Tender.TenderNumber
                    </h3>

                    <h5 class="text-muted fw-normal">
                        @Model.Tender.Title
                    </h5>

                </div>

                <span class="badge bg-secondary fs-6">
                    @Model.Case.Status
                </span>

            </div>

            <hr />

            <div class="row mb-4">

                <div class="col-md-6">

                    <h5 class="table-header-brand mb-3">
                        <i class="bi bi-file-earmark-text me-2"></i>
                        Tender Details
                    </h5>

                    <table class="table table-sm">

                        <tbody>

                            <tr>
                                <th width="180">Tender Number</th>
                                <td>@Model.Tender.TenderNumber</td>
                            </tr>

                            <tr>
                                <th>Employer</th>
                                <td>@Model.Tender.Employer</td>
                            </tr>

                            <tr>
                                <th>Closing Date</th>
                                <td>@Model.Tender.ClosingDate.ToString("dd MMM yyyy HH:mm")</td>
                            </tr>

                            <tr>
                                <th>Tender Link</th>
                                <td>
                                    <a href="@Model.Tender.TenderUrl"
                                       target="_blank">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>
                                        Visit Originating Site
                                    </a>
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

                <div class="col-md-6">

                    <h5 class="table-header-brand mb-3">
                        <i class="bi bi-shield-check me-2"></i>
                        Compliance Details
                    </h5>

                    <table class="table table-sm">

                        <tbody>

                            <tr>
                                <th width="180">Priority</th>
                                <td>@Model.Case.Priority</td>
                            </tr>

                            <tr>
                                <th>Status</th>
                                <td>@Model.Case.Status</td>
                            </tr>

                            <tr>
                                <th>Assigned Agent</th>
                                <td>@(Model.Case.Agent ?? "-")</td>
                            </tr>

                            <tr>
                                <th>Outcome</th>
                                <td>@(Model.Case.Outcome?.ToString() ?? "-")</td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

            <hr />

            @if (Model.Case.Status != "Closed")
            {
                <div class="d-flex flex-wrap gap-2 mb-4">

                    @* ========================================================= *@
                    @* ASSIGN AGENT                                              *@
                    @* ========================================================= *@

                    @if (Model.Case.Agent == null && CanAssignAgent)
                    {
                        <button class="btn btn-sm btn-cidb-submit"
                                @onclick="OpenAssignAgent">

                            <i class="bi bi-person-plus me-1"></i>
                            Assign Agent

                        </button>
                    }
                    else
                    {
                        @* ===================================================== *@
                        @* CORRESPONDENCE / DOCUMENT LOGIC                      *@
                        @* Only available once an agent has been assigned.      *@
                        @* ===================================================== *@

                        @if (Model.Case.Agent != null && CanManageCorrespondence)
                        {
                            if (NextCorrespondence != null)
                            {
                                if (NextCorrespondence.CanGenerate)
                                {
                                    <button class="btn btn-sm btn-cidb-submit-outline"
                                            @onclick="GenerateNextCorrespondence">

                                        <i class="bi bi-file-earmark-pdf me-1"></i>
                                        @NextCorrespondence.Title

                                    </button>

                                    @if (!string.IsNullOrWhiteSpace(
                                        NextCorrespondence.ResponsePeriodText))
                                    {
                                        <small class="text-muted ms-2 align-self-center">
                                            Response required within
                                            <strong>
                                                @NextCorrespondence.ResponsePeriodText
                                            </strong>
                                        </small>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0">
                                        <strong>@NextCorrespondence.Title</strong>
                                        <br />
                                        @NextCorrespondence.Description
                                    </div>
                                }
                            }
                            else if (Model.Letters.Any())
                            {
                                <button class="btn btn-sm btn-cidb-submit"
                                        @onclick="OpenCaptureResponse">

                                    <i class="bi bi-check-circle me-1"></i>
                                    Capture Response

                                </button>
                            }
                        }
                    }
                </div>
            }
            else
            {
                <div class="alert alert-danger">

                    This compliance case has been closed and is marked as
                    <strong>@Model.Case.Outcome</strong>.

                </div>
            }
            
            <hr />

            <!-- ========================================================== -->
            <!-- FINDINGS & ACTIONS – IMPROVED CARDS -->
            <!-- ========================================================== -->
            <div class="row g-4 mb-4">

                <!-- FINDINGS COLUMN -->
                <div class="col-md-6">
                    <h5 class="table-header-brand mb-3">
                        <i class="bi bi-search me-2"></i>
                        Compliance Findings
                    </h5>
                    @if (Model.Findings.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var finding in Model.Findings)
                            {
                                var statusColor = finding.IsResolved ? "success" : "warning";
                                var statusText = finding.IsResolved ? "Resolved" : "Open";

                                <div class="card border-0 shadow-sm">
                                    <div class="card-body py-3 px-4">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <span class="badge bg-danger">@finding.Stream.ToDisplayName()</span>
                                                    <span class="badge bg-secondary">@finding.FindingType.ToDisplayName()</span>
                                                    <span class="badge bg-@statusColor">@statusText</span>
                                                </div>
                                                <div class="fw-semibold text-dark">
                                                    @finding.Description
                                                </div>
                                                <div class="mt-1 d-flex flex-wrap gap-3">
                                                    <small class="text-muted">
                                                        <i class="bi bi-clock me-1"></i>
                                                        Identified: @finding.IdentifiedAt.ToString("dd MMM yyyy HH:mm")
                                                    </small>
                                                    @if (!string.IsNullOrEmpty(finding.RegulatoryReference))
                                                    {
                                                        <small class="text-muted">
                                                            <i class="bi bi-book me-1"></i>
                                                            @finding.RegulatoryReference
                                                        </small>
                                                    }
                                                    <small class="text-muted">
                                                        <i class="bi bi-tag me-1"></i>
                                                        Status at check: @finding.TenderStatusAtCheck.ToDisplayName()
                                                    </small>
                                                </div>
                                            </div>
                                            <!-- Optional: small status indicator dot -->
                                            <div class="ms-3">
                                                <span class="badge rounded-pill bg-@statusColor" style="width:12px;height:12px;display:inline-block;"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No findings recorded.</div>
                    }
                </div>

                <!-- ACTIONS COLUMN -->
                <div class="col-md-6">
                    <h5 class="table-header-brand mb-3">
                        <i class="bi bi-list-task me-2"></i>
                        Compliance Actions
                    </h5>
                    @if (Model.Actions.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var action in Model.Actions.OrderByDescending(a => a.ActionDate))
                            {
                                var statusBg = action.Status switch
                                {
                                    ComplianceActionStatus.Pending => "warning",
                                    ComplianceActionStatus.Completed => "success",
                                    ComplianceActionStatus.Failed => "danger",
                                    ComplianceActionStatus.Overdue => "danger",
                                    _ => "secondary"
                                };
                                var statusText = action.Status.ToDisplayName();

                                <div class="card border-0 shadow-sm">
                                    <div class="card-body py-3 px-4">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                                    <span class="fw-semibold text-dark">@action.ActionType.ToDisplayName()</span>
                                                    <span class="badge bg-@statusBg">@statusText</span>
                                                    @if (action.ResponseDueDate.HasValue && action.Status != ComplianceActionStatus.Completed)
                                                    {
                                                        var due = action.ResponseDueDate.Value;
                                                        var isOverdue = due < DateTime.UtcNow;
                                                        <span class="badge @(isOverdue ? "bg-danger" : "bg-secondary")">
                                                            @(isOverdue ? "Overdue" : "Due") @due.ToString("dd MMM")
                                                        </span>
                                                    }
                                                </div>
                                                <div class="mt-1 d-flex flex-wrap gap-3">
                                                    <small class="text-muted">
                                                        <i class="bi bi-calendar3 me-1"></i>
                                                        Actioned: @action.ActionDate.ToString("dd MMM yyyy HH:mm")
                                                    </small>
                                                    @if (action.ResponseDueDate.HasValue)
                                                    {
                                                        <small class="text-muted">
                                                            <i class="bi bi-hourglass-split me-1"></i>
                                                            Due: @action.ResponseDueDate.Value.ToString("dd MMM yyyy HH:mm")
                                                        </small>
                                                    }
                                                    @if (!string.IsNullOrEmpty(action.Comments))
                                                    {
                                                        <small class="text-muted">
                                                            <i class="bi bi-chat-left-text me-1"></i>
                                                            @action.Comments
                                                        </small>
                                                    }
                                                </div>
                                            </div>
                                            <!-- Status indicator dot -->
                                            <div class="ms-3">
                                                <span class="badge rounded-pill bg-@statusBg" style="width:12px;height:12px;display:inline-block;"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No actions recorded.</div>
                    }
                </div>

            </div>

            <hr />

            <!-- ========================================================== -->
            <!-- CORRESPONDENCE HISTORY -->
            <!-- ========================================================== -->
            <div class="row">
                <div class="col-lg-12">

                    <h5 class="table-header-brand mb-3">
                        <i class="bi bi-envelope-paper me-2"></i>
                        Correspondence History
                    </h5>

                    <table class="table table-striped table-hover align-middle">

                        <thead>

                            <tr>

                                <th>#</th>
                                <th>Letter</th>
                                <th>Recipient</th>
                                <th>Sent</th>
                                <th>Due</th>
                                <th>Status</th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (Model.Letters.Any())
                            {
                                @foreach (var letter in Model.Letters.OrderBy(x => x.LetterNumber))
                                {
                                    <tr>

                                        <!-- Number -->
                                        <td>
                                            @letter.LetterNumber
                                        </td>

                                        <!-- Correspondence Type -->
                                        <td>
                                            @switch (letter.Type)
                                            {
                                                case LetterType.Instruction:
                                                    <span class="badge bg-secondary">
                                                        <i class="bi bi-envelope me-1"></i>
                                                        Instructional Letter
                                                    </span>
                                                    break;

                                                case LetterType.ContraventionNotice:
                                                    <span class="badge bg-danger">
                                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                                        Contravention Notice
                                                    </span>
                                                    break;

                                                case LetterType.Erratum:
                                                    <span class="badge bg-secondary">
                                                        <i class="bi bi-pencil-square me-1"></i>
                                                        Erratum
                                                    </span>
                                                    break;

                                                default:
                                                    <span class="badge bg-secondary">
                                                        @letter.Type
                                                    </span>
                                                    break;
                                            }
                                        </td>

                                        <!-- Recipient -->
                                        <td>
                                            <div class="fw-semibold">
                                                @letter.RecipientName
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(letter.RecipientEmail))
                                            {
                                                <small class="text-muted">
                                                    @letter.RecipientEmail
                                                </small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">
                                                    No email recorded
                                                </small>
                                            }
                                        </td>

                                        <!-- Sent -->
                                        <td>
                                            <div>
                                                @letter.SentOn.ToString("dd MMM yyyy HH:mm")
                                            </div>
                                        </td>

                                        <!-- Due -->
                                        <td>
                                            @if (letter.Type == LetterType.Erratum)
                                            {
                                                <span class="text-muted">
                                                    N/A
                                                </span>
                                            }
                                            else
                                            {
                                                @letter.ResponseDueOn.ToString("dd MMM yyyy HH:mm")
                                            }
                                        </td>

                                        <!-- Status -->
                                        <td>

                                            @if (letter.Type == LetterType.Erratum)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Issued
                                                </span>
                                            }
                                            else if (letter.RespondedOn.HasValue)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Responded
                                                </span>
                                            }
                                            else if (letter.ResponseDueOn < DateTime.UtcNow)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-exclamation-circle me-1"></i>
                                                    Overdue
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-dark">
                                                    <i class="bi bi-hourglass-split me-1"></i>
                                                    Awaiting
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">

                                        <i class="bi bi-envelope-paper fs-4 d-block mb-2"></i>

                                        No correspondence has been sent.

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            </div>

            <hr />

            <!-- ========================================================== -->
            <!-- CASE NOTES -->
            <!-- ========================================================== -->
            <div class="row">
                <div class="col-lg-12">

                    <h5 class="table-header-brand mb-3">
                        <i class="bi bi-journal-text me-2"></i>
                        Case Notes
                    </h5>

                    @if (Model.Notes.Any())
                    {
                        <div class="notes-timeline">
                            @foreach (var note in Model.Notes.OrderByDescending(x => x.CreatedOn))
                            {
                                <div class="note-entry d-flex">
                                    <!-- Timeline dot + line -->
                                    <div class="note-line">
                                        <div class="note-dot"></div>
                                        @if (note != Model.Notes.Last())
                                        {
                                            <div class="note-line-vertical"></div>
                                        }
                                    </div>

                                    <!-- Note card -->
                                    <div class="note-content flex-grow-1 ps-3">
                                        <div class="card border-0 shadow-sm mb-3 note-card">
                                            <div class="card-body py-2 px-3">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <span class="fw-semibold text-secondary">
                                                        <i class="bi bi-person me-1"></i>
                                                        System
                                                    </span>
                                                    <small class="text-muted">
                                                        <i class="bi bi-clock me-1"></i>
                                                        @note.CreatedOn.ToString("dd MMM yyyy HH:mm")
                                                    </small>
                                                </div>
                                                <p class="mb-0 mt-1 text-dark" style="white-space: pre-line;">
                                                    @note.Note
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-journal-text fs-4 d-block mb-2"></i>
                            No notes have been added.
                        </div>
                    }

                </div>
            </div>
        </div>

        <!-- ========================================================== -->
        <!-- RIGHT COLUMN – ACTIVITY TIMELINE -->
        <!-- ========================================================== -->
        <div class="col-3">
            <div class="col-lg-12">

                <h5 class="table-header-brand mb-3">
                    <i class="bi bi-clock-history me-2"></i>
                    Activity
                </h5>

                @if (Model.Timeline.Any())
                {
                    @foreach (var audit in Model.Timeline.OrderByDescending(x => x.Date))
                    {
                        <div class="timeline-item">

                            <div class="timeline-icon">

                                @switch (audit.Action)
                                {
                                    case AuditAction.Created:
                                        <i class="bi bi-plus-circle-fill text-secondary"></i>
                                        break;

                                    case AuditAction.Assigned:
                                        <i class="bi bi-person-plus-fill text-secondary"></i>
                                        break;

                                    case AuditAction.Reassigned:
                                        <i class="bi bi-arrow-repeat text-secondary"></i>
                                        break;

                                    case AuditAction.InstructionLetterSent:
                                        <i class="bi bi-envelope-fill text-secondary"></i>
                                        break;

                                    case AuditAction.ReminderLetterSent:
                                        <i class="bi bi-bell-fill text-secondary"></i>
                                        break;

                                    case AuditAction.ResponseReceived:
                                        <i class="bi bi-check-circle-fill text-secondary"></i>
                                        break;

                                    case AuditAction.CaseClosed:
                                        <i class="bi bi-lock-fill text-secondary"></i>
                                        break;

                                    default:
                                        <i class="bi bi-dot"></i>
                                        break;
                                }

                            </div>

                            <div class="timeline-content">

                                <div class="fw-semibold">
                                    @audit.Action
                                </div>

                                <small class="text-muted">
                                    @audit.Date.ToString("dd MMM yyyy HH:mm")
                                </small>

                                <div class="mt-1">
                                    @audit.Description
                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">
                        No activity recorded.
                    </div>
                }

            </div>
        </div>
    </div>

    <!-- ========================================================== -->
    <!-- ASSIGN AGENT MODAL -->
    <!-- ========================================================== -->
    @if (ShowAssignAgentModal)
    {
        <div class="modal fade show d-block"
             tabindex="-1"
             style="background-color:rgba(0,0,0,.5)">

            <div class="modal-dialog modal-lg">

                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            Assign Compliance Agent
                        </h5>

                        <button class="btn-close"
                                @onclick="CloseAssignAgent">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label">
                                Agent <span class="text-danger">*</span>
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="SelectedAgentId">

                                <option value="">-- Select Agent --</option>

                                @foreach (var agent in Agents.OrderBy(x => x.FullName))
                                {
                                    <option value="@agent.Id">
                                        @agent.FullName (@agent.OpenCases open cases)
                                    </option>
                                }

                            </InputSelect>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Priority
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="SelectedPriority">

                                @foreach (var priority in Enum.GetValues<CasePriority>())
                                {
                                    <option value="@priority">
                                        @priority
                                    </option>
                                }

                            </InputSelect>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Assignment Comments
                            </label>

                            <InputTextArea class="form-control"
                                           rows="4"
                                           maxlength="500"
                                           @bind-Value="AssignmentComments" />

                            <small class="text-muted">
                                Optional notes for the assigned agent.
                            </small>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button class="btn btn-sm btn-secondary"
                                @onclick="CloseAssignAgent">
                            Cancel
                        </button>

                        <button class="btn btn-sm btn-cidb-submit"
                                @onclick="AssignAgent">
                            <i class="bi bi-person-plus me-1"></i>
                            Assign Agent
                        </button>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- ========================================================== -->
    <!-- CAPTURE RESPONSE MODAL -->
    <!-- ========================================================== -->
    @if (ShowCaptureResponseModal)
    {
        <div class="modal fade show d-block"
             tabindex="-1"
             style="background-color:rgba(0,0,0,.5)">

            <div class="modal-dialog">

                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            Capture Response
                        </h5>

                        <button class="btn-close"
                                @onclick="CloseCaptureResponse">
                        </button>

                    </div>

                    <div class="modal-body">

                        <!-- Outcome -->

                        <div class="mb-3">

                            <label class="form-label">
                                Outcome
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="Response.Outcome">

                                <option value="@ComplianceOutcome.Compliant">
                                    Compliant
                                </option>

                                <option value="@ComplianceOutcome.NonCompliant">
                                    Non-Compliant
                                </option>

                            </InputSelect>

                        </div>

                        <!-- Date -->

                        <div class="mb-3">

                            <label class="form-label">
                                Response Date
                            </label>

                            <InputDate class="form-control"
                                       @bind-Value="Response.RespondedOn" />

                        </div>

                        <!-- Comments -->

                        <div class="mb-3">

                            <label class="form-label">
                                Comments
                            </label>

                            <InputTextArea class="form-control"
                                           rows="4"
                                           @bind-Value="Response.Comments" />

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button class="btn btn-sm btn-secondary"
                                @onclick="CloseCaptureResponse">
                            Cancel
                        </button>

                        <button class="btn btn-sm btn-cidb-submit"
                                @onclick="SaveResponse">

                            Save Response

                        </button>

                    </div>

                </div>

            </div>

        </div>
    }
}

@code {
    private bool CanAssignAgent;
    private bool CanManageCorrespondence;
    private CaptureResponseModel Response = new();
    private NextCorrespondenceModel? NextCorrespondence;
    public List<CaseNoteModel> Notes { get; set; } = [];

    private bool ShowCaptureResponseModal;

    private CasePriority SelectedPriority = CasePriority.Normal;

    private string AssignmentComments = string.Empty;

    private bool ShowAssignAgentModal;

    private Guid? SelectedAgentId;

    private List<AgentLookupModel> Agents = [];

    [Parameter]
    public Guid Id { get; set; }

    private ComplianceCaseDetailModel? Model;

    private bool CanSendInstructionLetter =>
        Model != null &&
        Model.Case.Agent != null &&
        !Model.Letters.Any();

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
        await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authenticationState.User;

        CanAssignAgent =
            (await AuthorizationService.AuthorizeAsync(
                user,
                "CaseAssignment")).Succeeded;

        CanManageCorrespondence =
            (await AuthorizationService.AuthorizeAsync(
                user,
                "Correspondence")).Succeeded;

        await RefreshCase();

        if (Model != null)
        {
            NextCorrespondence =
                await ComplianceService.GetNextCorrespondenceAsync(Id);
        }
    }

    private async Task RefreshCase()
    {
        Model = await Repository.GetDetailAsync(Id);

        if (Model != null)
        {
            NextCorrespondence =
                await ComplianceService.GetNextCorrespondenceAsync(Id);
        }
    }

    private async Task OpenAssignAgent()
    {
        Agents = await AgentRepository.GetLookupAsync();

        SelectedAgentId = null;

        SelectedPriority = Model.Case.Priority;

        AssignmentComments = Model.Case.Comments ?? string.Empty;

        ShowAssignAgentModal = true;
    }

    private void CloseAssignAgent()
    {
        ShowAssignAgentModal = false;
    }

    private async Task AssignAgent()
    {
        if (!SelectedAgentId.HasValue)
            return;

        await ComplianceService.AssignAgentAsync(
            Model.Id,
            SelectedAgentId.Value,
            SelectedPriority,
            AssignmentComments);

        ShowAssignAgentModal = false;

        if (!string.IsNullOrWhiteSpace(AssignmentComments))
        {
            var note = new CaseNote
            {
                Id = Guid.NewGuid(),
                ComplianceCaseId = Model.Id,
                Comment = $"Agent assigned. Priority: {SelectedPriority}.{Environment.NewLine}Comment: {AssignmentComments}",
                CreatedOn = DateTime.UtcNow
            };
            await CaseNoteRepository.AddAsync(note);
        }

        Model = await Repository.GetDetailAsync(Id);
    }

    private async Task GenerateNextCorrespondence()
    {
        if (Model == null)
            return;

        // Documents may only be generated once an agent
        // has been assigned to the compliance case.
        if (Model.Case.AgentId == null)
            return;

        if (NextCorrespondence == null)
            return;

        if (!NextCorrespondence.CanGenerate ||
            !NextCorrespondence.Type.HasValue)
            return;

        byte[] pdf;

        switch (NextCorrespondence.Type.Value)
        {
            // case CorrespondenceTemplateType.AGSAReferral:

            //     pdf = await CorrespondenceService
            //         .Gen(Model.Id);

            //     break;

            // case CorrespondenceTemplateType.InstructionLetter:

            //     pdf = await CorrespondenceService.SendInstructionLetterAsync(Model., CancellationToken.None);

            //     break;

            // case CorrespondenceTemplateType.ContraventionNotice:

            //     pdf = await CorrespondenceService
            //         .GenerateContraventionNoticeAsync(Model.Id);

            //     break;

            default:

                throw new InvalidOperationException(
                    "Unsupported correspondence type.");
        }

        var fileName = NextCorrespondence.Type.Value switch
        {
            CorrespondenceTemplateType.InstructionLetter =>
                $"InstructionalLetter-{Model.Tender.TenderNumber}.pdf",

            CorrespondenceTemplateType.ContraventionNotice =>
                $"ContraventionNotice-{Model.Tender.TenderNumber}.pdf",

            CorrespondenceTemplateType.AGSAReferral =>
                $"Erratum-{Model.Tender.TenderNumber}.pdf",

            _ =>
                $"Correspondence-{Model.Tender.TenderNumber}.pdf"
        };

        using var stream = new MemoryStream(pdf);

        using var streamRef =
            new DotNetStreamReference(stream);

        await JS.InvokeVoidAsync(
            "downloadFileFromStream",
            fileName,
            streamRef);

        await RefreshCase();
    }

    private void OpenCaptureResponse()
    {
        var latestLetter = Model!.Letters
            .OrderByDescending(x => x.LetterNumber)
            .First(x => !x.RespondedOn.HasValue);

        Response = new CaptureResponseModel
        {
            ComplianceCaseId = Model.Id,
            CaseLetterId = latestLetter.Id,
            RespondedOn = DateTime.UtcNow
        };

        ShowCaptureResponseModal = true;
    }

    private void CloseCaptureResponse()
    {
        ShowCaptureResponseModal = false;
    }

    private async Task SaveResponse()
    {
        //await CorrespondenceService.CaptureResponseAsync(Response);

        if (!string.IsNullOrWhiteSpace(Response.Comments))
        {
            var note = new CaseNote
            {
                Id = Guid.NewGuid(),
                ComplianceCaseId = Model.Id,
                Comment = $"Response Captured. Comments: {Response.Comments}",
                CreatedOn = DateTime.UtcNow
            };

            await CaseNoteRepository.AddAsync(note);
        }

        ShowCaptureResponseModal = false;

        Model = await Repository.GetDetailAsync(Id);
    }
}