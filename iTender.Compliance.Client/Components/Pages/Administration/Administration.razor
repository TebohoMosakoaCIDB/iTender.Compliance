@page "/administration"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using iTender.Compliance.Application.DTOs
@using iTender.Compliance.Application.Interfaces.Repositories
@using iTender.Compliance.Application.Interfaces.Services
@using iTender.Compliance.Application.Models.Reports
@using iTender.Compliance.Domain.Entities
@using iTender.Compliance.Domain.Enums

@attribute [Authorize(Policy = "Administration")]

@inject ISynchronizationService SynchronizationService
@inject IReportingService ReportingService
@inject ISystemSettingService SettingService
@inject ITenderSyncLogRepository LogRepository
@inject ITenderSyncRepository TenderSyncRepository
@inject NavigationManager Navigation

<PageTitle>Administration | CRCIP Monitor</PageTitle>
<div class="container-fluid px-4">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mt-3 mb-4">

        <div>

            <h2 class="mb-1">

                <i class="bi bi-gear-wide-connected me-2"></i>

                Administration

            </h2>

            <p class="text-muted mb-0">
                Manage tender synchronization, system configuration and case assignment.
            </p>

        </div>

        <button class="btn btn-sm btn-cidb-submit"
                @onclick="RunSynchronization"
                disabled="@IsRunning">

            @if (IsRunning)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>

                <span>
                    Synchronizing...
                </span>
            }
            else
            {
                <i class="bi bi-arrow-repeat me-2"></i>

                <span>
                    Run Synchronization
                </span>
            }

        </button>

    </div>


    <!-- ===================================================== -->
    <!-- ALERTS -->
    <!-- ===================================================== -->
    @if (ShowSuccessMessage)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @SuccessMessage

            <button type="button"
                    class="btn-close"
                    @onclick="() => ShowSuccessMessage = false">
            </button>

        </div>
    }


    @if (ShowErrorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @ErrorMessage

            <button type="button"
                    class="btn-close"
                    @onclick="() => ShowErrorMessage = false">
            </button>

        </div>
    }


    <!-- ===================================================== -->
    <!-- SYNCHRONIZATION SUMMARY -->
    <!-- ===================================================== -->

    <div class="row g-3 mb-4">

        <!-- Total Synchronizations -->

        <div class="col-xl-3 col-md-6">

            <div class="card dashboard-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Total Synchronizations
                            </div>

                            <div class="display-6 fw-bold text-primary">
                                @Model.TotalSynchronizations
                            </div>

                        </div>

                        <i class="bi bi-arrow-repeat display-5 text-primary opacity-50"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Tenders Retrieved -->

        <div class="col-xl-3 col-md-6">

            <div class="card dashboard-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Tenders Retrieved
                            </div>

                            <div class="display-6 fw-bold text-success">
                                @Model.TotalRetrieved
                            </div>

                        </div>

                        <i class="bi bi-download display-5 text-success opacity-50"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Cases Created -->

        <div class="col-xl-3 col-md-6">

            <div class="card dashboard-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Cases Created
                            </div>

                            <div class="display-6 fw-bold text-warning">
                                @Model.TotalCasesCreated
                            </div>

                        </div>

                        <i class="bi bi-folder-plus display-5 text-warning opacity-50"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Failed Synchronizations -->

        <div class="col-xl-3 col-md-6">

            <div class="card dashboard-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Failed Synchronizations
                            </div>

                            <div class="display-6 fw-bold text-danger">
                                @Model.FailedSynchronizations
                            </div>

                        </div>

                        <i class="bi bi-exclamation-triangle display-5 text-danger opacity-50"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SYSTEM STATUS -->
    <!-- ===================================================== -->

    <div class="card mb-4">

        <div class="card-header">

            <h6 class="mb-0">

                <i class="bi bi-shield-check me-2"></i>

                System Status

            </h6>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <!-- Synchronization -->

                <div class="col-md-4">

                    <div class="d-flex align-items-center">

                        <div class="status-icon bg-success-subtle text-success">

                            <i class="bi bi-arrow-repeat"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Synchronization Service
                            </div>

                            <strong class="text-success">
                                @(IsRunning ? "Running" : "Operational")
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Auto Assignment -->

                <div class="col-md-4">

                    <div class="d-flex align-items-center">

                        <div class="status-icon @(Settings.AutoAssignmentEnabled
                                                        ? "bg-success-subtle text-success"
                                                        : "bg-secondary-subtle text-secondary")">

                            <i class="bi bi-person-check"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Automatic Assignment
                            </div>

                            <strong>
                                @(Settings.AutoAssignmentEnabled
                                    ? "Enabled"
                                    : "Disabled")
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Synchronization Interval -->

                <div class="col-md-4">

                    <div class="d-flex align-items-center">

                        <div class="status-icon bg-primary-subtle text-primary">

                            <i class="bi bi-clock-history"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Synchronization Interval
                            </div>

                            <strong>
                                @Settings.SynchronizationIntervalHours hours
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SYNCHRONIZATION HISTORY -->
    <!-- ===================================================== -->

    <div class="card mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h6 class="mb-0">

                <i class="bi bi-clock-history me-2"></i>

                Synchronization History

            </h6>

            <button class="btn btn-sm btn-cidb-submit"
                    @onclick="OpenSynchronizationHistory">

                <i class="bi bi-list-ul me-1"></i>

                View All

            </button>

        </div>


        @if (Synchronizations?.Items.Any() == true)
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>Started</th>

                            <th>Completed</th>

                            <th>Type</th>

                            <th>Status</th>

                            <th>Retrieved</th>

                            <th>Compliant</th>

                            <th>Non-Compliant</th>

                            <th>Cases</th>

                            <th>Errors</th>

                            <th></th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var sync in Synchronizations.Items)
                        {
                            <tr>

                                <!-- Started -->

                                <td>

                                    <div class="fw-semibold">
                                        @sync.StartedOn.ToString("dd MMM yyyy")
                                    </div>

                                    <small class="text-muted">
                                        @sync.StartedOn.ToString("HH:mm")
                                    </small>

                                </td>


                                <!-- Completed -->

                                <td>

                                    @if (sync.CompletedOn.HasValue)
                                    {
                                        <div>
                                            @sync.CompletedOn.Value.ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @sync.CompletedOn.Value.ToString("HH:mm")
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- Type -->

                                <td>

                                    @if (sync.IsManual)
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-person me-1"></i>
                                            Manual
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-clock me-1"></i>
                                            Scheduled
                                        </span>
                                    }

                                </td>


                                <!-- Status -->

                                <td>

                                    @switch (sync.Status)
                                    {
                                        case SyncStatus.Completed:

                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1"></i>

                                                Completed

                                            </span>

                                            break;

                                        case SyncStatus.Running:

                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-arrow-repeat me-1"></i>

                                                Running

                                            </span>

                                            break;

                                        default:

                                            <span class="badge bg-danger">

                                                <i class="bi bi-x-circle me-1"></i>

                                                Failed

                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- Retrieved -->

                                <td>
                                    @sync.TotalRetrieved
                                </td>


                                <!-- Compliant -->

                                <td>

                                    <span class="text-success fw-semibold">
                                        @sync.TotalCompliant
                                    </span>

                                </td>


                                <!-- Non-Compliant -->

                                <td>

                                    <span class="text-danger fw-semibold">
                                        @sync.TotalNonCompliant
                                    </span>

                                </td>


                                <!-- Cases -->

                                <td>

                                    <span class="fw-semibold">
                                        @sync.CasesCreated
                                    </span>

                                </td>


                                <!-- Errors -->

                                <td>

                                    @if (sync.ErrorCount > 0)
                                    {
                                        <span class="badge bg-danger">
                                            @sync.ErrorCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            0
                                        </span>
                                    }

                                </td>


                                <!-- Action -->

                                <td>

                                    <button class="btn btn-sm btn-cidb-submit"
                                            title="View synchronization details"
                                            @onclick="() => OpenSynchronization(sync.Id)">

                                        <i class="bi bi-eye me-1"></i>

                                        View

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">

                <i class="bi bi-clock-history display-5"></i>

                <p class="mt-3 mb-1">
                    No synchronization history found.
                </p>

                <small>
                    Synchronization activity will appear here after the first run.
                </small>

            </div>
        }

    </div>


    <!-- ===================================================== -->
    <!-- SYSTEM SETTINGS -->
    <!-- ===================================================== -->

    <div class="card mb-4">

        <div class="card-header">

            <h6 class="mb-0">

                <i class="bi bi-sliders me-2"></i>

                System Settings

            </h6>

        </div>


        <div class="card-body">

            <!-- CASE MANAGEMENT -->

            <div class="settings-section">

                <div class="settings-section-title">

                    <i class="bi bi-folder2-open me-2"></i>

                    Case Management

                </div>

                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">

                        <label class="form-label">
                            Response Due
                        </label>

                        <div class="input-group">

                            <InputNumber class="form-control"
                                         @bind-Value="Settings.ResponseDueHours" />

                            <span class="input-group-text">
                                Hours
                            </span>

                        </div>

                        <div class="form-text">
                            Time allowed for a client response.
                        </div>

                    </div>

                    <div class="col-lg-4 col-md-6">

                        <label class="form-label">
                            Reminder Delay
                        </label>

                        <div class="input-group">

                            <InputNumber class="form-control"
                                         @bind-Value="Settings.ReminderDelayHours" />

                            <span class="input-group-text">
                                Hours
                            </span>

                        </div>

                        <div class="form-text">
                            Time between response reminders.
                        </div>

                    </div>

                    <div class="col-lg-4 col-md-6">

                        <label class="form-label">
                            Maximum Reminders
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="Settings.MaximumReminders" />

                        <div class="form-text">
                            Maximum number of reminders sent for a case.
                        </div>

                    </div>
                </div>

            </div>


            <hr class="my-4" />


            <!-- SYNCHRONIZATION -->

            <div class="settings-section">

                <div class="settings-section-title">

                    <i class="bi bi-arrow-repeat me-2"></i>

                    Synchronization

                </div>

                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">

                        <label class="form-label">
                            Synchronization Interval
                        </label>

                        <div class="input-group">

                            <InputNumber class="form-control"
                                         @bind-Value="Settings.SynchronizationIntervalHours" />

                            <span class="input-group-text">
                                Hours
                            </span>

                        </div>

                        <div class="form-text">
                            Frequency of scheduled tender synchronization.
                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- CASE ASSIGNMENT -->

            <div class="settings-section">

                <div class="settings-section-title">

                    <i class="bi bi-people me-2"></i>

                    Case Assignment

                </div>

                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">

                        <label class="form-label">
                            Distribution Method
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="Settings.DistributionMethod">

                            @foreach (var method in Enum.GetValues<CaseDistributionMethod>())
                            {
                                <option value="@method">
                                    @method
                                </option>
                            }

                        </InputSelect>

                        <div class="form-text">
                            @GetDistributionMethodDescription(
                                Settings.DistributionMethod)
                        </div>

                    </div>


                    <div class="col-lg-4 col-md-6 d-flex align-items-center">

                        <div>

                            <div class="form-check form-switch">

                                <InputCheckbox class="form-check-input"
                                               @bind-Value="Settings.AutoAssignmentEnabled" />

                                <label class="form-check-label fw-semibold">
                                    Automatic Assignment
                                </label>

                            </div>

                            <div class="form-text ms-5">

                                Automatically assign newly created cases
                                to eligible compliance officers.

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- PAGINATION -->

            <div class="settings-section">

                <div class="settings-section-title">

                    <i class="bi bi-list-ol me-2"></i>

                    Pagination

                </div>

                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">

                        <label class="form-label">
                            Default Page Size
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="Settings.DefaultPageSize" />

                        <div class="form-text">
                            Number of records displayed per page by default.
                        </div>

                    </div>

                </div>

            </div>


            <!-- SAVE -->

            <div class="d-flex justify-content-end mt-4">

                <button class="btn btn-sm btn-cidb-submit"
                        @onclick="SaveSettings">

                    <i class="bi bi-check2 me-2"></i>

                    Save Settings

                </button>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- SYNCHRONIZATION DETAIL MODAL -->
<!-- ========================================================= -->
@if (ShowSyncDetailModal && SelectedSynchronization != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color:rgba(0,0,0,.5)">

        <div class="modal-dialog modal-xl modal-dialog-scrollable">

            <div class="modal-content">


                <!-- HEADER -->

                <div class="modal-header">

                    <h5 class="modal-title">

                        <i class="bi bi-clock-history me-2"></i>

                        Synchronization Details

                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseSynchronization">
                    </button>

                </div>


                <!-- BODY -->

                <div class="modal-body">


                    <!-- SUMMARY -->

                    <div class="row g-3 mb-4">

                        <div class="col-md-3">

                            <div class="border rounded p-3 h-100">

                                <small class="text-muted d-block">
                                    Started
                                </small>

                                <strong>
                                    @SelectedSynchronization.StartedOn.ToString("dd MMM yyyy HH:mm")
                                </strong>

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="border rounded p-3 h-100">

                                <small class="text-muted d-block">
                                    Completed
                                </small>

                                <strong>

                                    @(SelectedSynchronization.CompletedOn?
                                        .ToString("dd MMM yyyy HH:mm") ?? "-")

                                </strong>

                            </div>

                        </div>


                        <div class="col-md-2">

                            <div class="border rounded p-3 text-center h-100">

                                <small class="text-muted d-block">
                                    Retrieved
                                </small>

                                <h4 class="mb-0">
                                    @SelectedSynchronization.TotalRetrieved
                                </h4>

                            </div>

                        </div>


                        <div class="col-md-2">

                            <div class="border rounded p-3 text-center h-100">

                                <small class="text-muted d-block">
                                    Cases
                                </small>

                                <h4 class="mb-0 text-warning">
                                    @SelectedSynchronization.CasesCreated
                                </h4>

                            </div>

                        </div>


                        <div class="col-md-2">

                            <div class="border rounded p-3 text-center h-100">

                                <small class="text-muted d-block">
                                    Errors
                                </small>

                                <h4 class="mb-0
                                    @(SelectedSynchronization.ErrorCount > 0
                                        ? "text-danger"
                                        : "text-success")">

                                    @SelectedSynchronization.ErrorCount

                                </h4>

                            </div>

                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="mb-4">

                        <div class="d-flex align-items-center gap-2">

                            <span class="text-muted">
                                Status:
                            </span>

                            @if (SelectedSynchronization.ErrorCount > 0)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Errors Detected
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Completed Successfully
                                </span>
                            }

                        </div>

                    </div>


                    <hr />


                    <!-- TIMELINE -->

                    <h6 class="mb-4">

                        <i class="bi bi-list-check me-2"></i>

                        Synchronization Timeline

                    </h6>


                    @if (SelectedSynchronization.Logs.Any())
                    {
                        <div class="sync-timeline">

                            @foreach (var log in SelectedSynchronization.Logs)
                            {
                                <div class="sync-timeline-item">

                                    <div class="sync-timeline-icon">

                                        @switch (log.Level)
                                        {
                                            case SyncLogLevel.Information:

                                                <i class="bi bi-info-circle-fill text-primary"></i>

                                                break;

                                            case SyncLogLevel.Warning:

                                                <i class="bi bi-exclamation-circle-fill text-warning"></i>

                                                break;

                                            case SyncLogLevel.Error:

                                                <i class="bi bi-x-circle-fill text-danger"></i>

                                                break;
                                        }

                                    </div>


                                    <div class="sync-timeline-content">

                                        <div class="d-flex justify-content-between align-items-start">

                                            <strong>
                                                @log.Title
                                            </strong>

                                            <small class="text-muted ms-3">

                                                @log.Date.ToString(
                                                    "dd MMM yyyy HH:mm:ss")

                                            </small>

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(log.TenderNumber))
                                        {
                                            <div class="text-primary fw-semibold mt-1">

                                                <i class="bi bi-file-earmark-text me-1"></i>

                                                @log.TenderNumber

                                            </div>
                                        }


                                        <div class="mt-1 text-muted">
                                            @log.Message
                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">

                            <i class="bi bi-clock-history display-5"></i>

                            <p class="mt-3 mb-0">
                                No synchronization logs were recorded.
                            </p>

                        </div>
                    }

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            @onclick="CloseSynchronization">

                        <i class="bi bi-x-circle me-2"></i>

                        Close

                    </button>

                </div>

            </div>

        </div>

    </div>
}


<style>

    .status-icon {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
        font-size: 1.2rem;
    }

    .settings-section-title {
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 1rem;
        color: #343a40;
    }

        .settings-section-title i {
            color: #b3202a;
        }

    .sync-timeline {
        position: relative;
        padding-left: 10px;
    }

    .sync-timeline-item {
        display: flex;
        position: relative;
        padding-bottom: 1.5rem;
    }

        .sync-timeline-item:last-child {
            padding-bottom: 0;
        }

    .sync-timeline-icon {
        width: 32px;
        min-width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 50%;
        position: relative;
        z-index: 2;
        margin-right: 12px;
    }

    .sync-timeline-item:not(:last-child)::after {
        content: "";
        position: absolute;
        left: 25px;
        top: 32px;
        bottom: 0;
        width: 1px;
        background-color: #dee2e6;
    }

    .sync-timeline-content {
        flex-grow: 1;
        border-bottom: 1px solid #f0f0f0;
        padding-bottom: 1rem;
    }

    .sync-timeline-item:last-child .sync-timeline-content {
        border-bottom: none;
    }

</style>


@code {

    private bool ShowSyncDetailModal;

    private TenderSyncDetailModel? SelectedSynchronization;

    private bool ShowErrorMessage;

    private string ErrorMessage = string.Empty;

    private bool ShowSuccessMessage;

    private string SuccessMessage = string.Empty;

    private SystemSettingModel Settings = new();

    private SyncReportModel Model = new();

    private PagedResult<TenderSync>? Synchronizations;

    private TenderSyncSearchModel Search = new();

    private bool IsRunning;


    protected override async Task OnInitializedAsync()
    {
        Model =
            await ReportingService.GetSynchronizationReportAsync(
                DateTime.MinValue,
                DateTime.UtcNow);

        Search = new TenderSyncSearchModel
        {
            PageNumber = 1,
            PageSize = 5
        };

        Synchronizations =
            await TenderSyncRepository.SearchAsync(Search);

        Settings =
            await SettingService.GetAsync();
    }


    private async Task RunSynchronization()
    {
        ShowErrorMessage = false;
        ShowSuccessMessage = false;

        IsRunning = true;

        await InvokeAsync(StateHasChanged);

        try
        {
            await SynchronizationService.SynchronizeAsync(true);

            Model =
                await ReportingService.GetSynchronizationReportAsync(
                    DateTime.MinValue,
                    DateTime.UtcNow);

            SuccessMessage =
                "Tender synchronization completed successfully.";

            ShowSuccessMessage = true;
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"Synchronization failed: {ex.Message}";

            ShowErrorMessage = true;
        }
        finally
        {
            IsRunning = false;

            Synchronizations =
                await TenderSyncRepository.SearchAsync(Search);

            Settings =
                await SettingService.GetAsync();

            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task SaveSettings()
    {
        ShowErrorMessage = false;
        ShowSuccessMessage = false;

        try
        {
            await SettingService.SaveAsync(Settings);

            SuccessMessage = "System settings saved successfully.";
            ShowSuccessMessage = true;

            await InvokeAsync(StateHasChanged);

            await Task.Delay(1000);

            Navigation.NavigateTo("/administration", forceLoad: true);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to save system settings: {ex.Message}";
            ShowErrorMessage = true;

            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task OpenSynchronization(Guid id)
    {
        SelectedSynchronization =
            await LogRepository.GetDetailAsync(id);

        ShowSyncDetailModal =
            SelectedSynchronization != null;
    }


    private void CloseSynchronization()
    {
        ShowSyncDetailModal = false;

        SelectedSynchronization = null;
    }


    private void OpenSynchronizationHistory()
    {
        Navigation.NavigateTo(
            "/administration/synchronizations");
    }


    private static string GetDistributionMethodDescription(
        CaseDistributionMethod method)
    {
        return method switch
        {
            CaseDistributionMethod.Manual =>
                "Cases are not assigned automatically. Supervisors assign each case manually.",

            CaseDistributionMethod.RoundRobin =>
                "Cases are distributed evenly by assigning each new case to the next available agent in sequence.",

            CaseDistributionMethod.LeastWorkload =>
                "Each new case is assigned to the eligible agent with the fewest open cases.",

            CaseDistributionMethod.Random =>
                "A random eligible agent is selected for each new case.",

            CaseDistributionMethod.PriorityBased =>
                "Cases are assigned based on priority rules, ensuring high-priority cases are handled by the most appropriate agents.",

            _ => string.Empty
        };
    }

}