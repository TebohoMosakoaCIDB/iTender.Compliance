@page "/administration"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using iTender.Compliance.Application.DTOs
@using iTender.Compliance.Application.Interfaces.Repositories
@using iTender.Compliance.Application.Interfaces.Services
@using iTender.Compliance.Application.Models.Reports
@using iTender.Compliance.Domain.Entities
@using iTender.Compliance.Domain.Enums

@attribute [Authorize(Policy = "Administration")]

@inject ISynchronizationService SynchronizationService
@inject IReportingService ReportingService
@inject ISystemSettingService SettingService
@inject ITenderSyncLogRepository LogRepository
@inject ITenderSyncRepository TenderSyncRepository
@inject IReminderService ReminderService
@inject IEscalationService EscalationService
@inject IDocumentSigningService DocumentSigningService
@inject ICorrespondenceService CorrespondenceService
@inject NavigationManager Navigation

<PageTitle>Administration | CRCIP Monitor</PageTitle>
<div class="container-fluid px-4">
    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->
    <div class="d-flex justify-content-between align-items-center mt-3 mb-4">

        <div>

            <h2 class="mb-1">

                <i class="bi bi-gear-wide-connected me-2"></i>

                Administration

            </h2>

            <p class="text-muted mb-0">
                Manage tender synchronization, system configuration and case assignment.
            </p>

        </div>

        <button class="btn btn-sm btn-cidb-submit"
                @onclick="RunSynchronization"
                disabled="@IsRunning">

            @if (IsRunning)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>

                <span>
                    Synchronizing...
                </span>
            }
            else
            {
                <i class="bi bi-arrow-repeat me-2"></i>

                <span>
                    Run Synchronization
                </span>
            }

        </button>

    </div>

    <!-- ===================================================== -->
    <!-- ALERTS -->
    <!-- ===================================================== -->
    @if (ShowSuccessMessage)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @SuccessMessage

            <button type="button"
                    class="btn-close"
                    @onclick="() => ShowSuccessMessage = false">
            </button>

        </div>
    }


    @if (ShowErrorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @ErrorMessage

            <button type="button"
                    class="btn-close"
                    @onclick="() => ShowErrorMessage = false">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- MANUAL AUTOMATION TRIGGERS (testing) -->
    <!-- ========================================================= -->
    <div class="card mt-4 mb-4">

        <div class="card-header">

            <i class="bi bi-lightning-charge me-2"></i>
            Automation - Manual Triggers

        </div>

        <div class="card-body">

            <p class="text-muted">
                These run the same background passes on demand, so you don't have to wait for the
                scheduled interval while testing. Safe to run repeatedly - each pass only acts on
                cases that are actually due.
            </p>

            <div class="d-flex flex-wrap gap-3">

                <div>

                    <button class="btn btn-sm btn-cidb-submit-outline"
                            disabled="@_runningReminders"
                            @onclick="RunRemindersNow">

                        @if (_runningReminders)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-bell me-2"></i>
                        }
                        Run Reminders Now

                    </button>

                </div>

                <div>

                    <button class="btn btn-sm btn-cidb-submit-outline"
                            disabled="@_runningEscalation"
                            @onclick="RunEscalationNow">

                        @if (_runningEscalation)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-up-circle me-2"></i>
                        }
                        Run Escalation Now

                    </button>

                </div>

                <div>

                    <button class="btn btn-sm btn-cidb-submit-outline"
                            disabled="@_runningSigningPoll"
                            @onclick="RunSigningPollNow">

                        @if (_runningSigningPoll)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-pen me-2"></i>
                        }
                        Run SigningHub Poll Now

                    </button>

                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(_triggerResultMessage))
            {
                <div class="alert @(_triggerResultIsError ? "alert-danger" : "alert-success") mt-3 mb-0">
                    @_triggerResultMessage
                </div>
            }

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- SYNCHRONIZATION SUMMARY -->
    <!-- ===================================================== -->
    <div class="row g-3 mb-4">

        <!-- Total Synchronizations -->

        <div class="col-xl-3 col-md-6">

            <div class="card dashboard-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Total Synchronizations
                            </div>

                            <div class="display-6 fw-bold text-primary">
                                @Model.TotalSynchronizations
                            </div>

                        </div>

                        <i class="bi bi-arrow-repeat display-5 text-primary opacity-50"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Tenders Retrieved -->

        <div class="col-xl-3 col-md-6">

            <div class="card dashboard-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Tenders Retrieved
                            </div>

                            <div class="display-6 fw-bold text-success">
                                @Model.TotalRetrieved
                            </div>

                        </div>

                        <i class="bi bi-download display-5 text-success opacity-50"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Cases Created -->

        <div class="col-xl-3 col-md-6">

            <div class="card dashboard-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Cases Created
                            </div>

                            <div class="display-6 fw-bold text-warning">
                                @Model.TotalCasesCreated
                            </div>

                        </div>

                        <i class="bi bi-folder-plus display-5 text-warning opacity-50"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Failed Synchronizations -->

        <div class="col-xl-3 col-md-6">

            <div class="card dashboard-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Failed Synchronizations
                            </div>

                            <div class="display-6 fw-bold text-danger">
                                @Model.FailedSynchronizations
                            </div>

                        </div>

                        <i class="bi bi-exclamation-triangle display-5 text-danger opacity-50"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- SYSTEM STATUS -->
    <!-- ===================================================== -->
    <div class="card mb-4">

        <div class="card-header">

            <h6 class="mb-0">

                <i class="bi bi-shield-check me-2"></i>

                System Status

            </h6>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <!-- Synchronization -->

                <div class="col-md-4">

                    <div class="d-flex align-items-center">

                        <div class="status-icon bg-success-subtle text-success">

                            <i class="bi bi-arrow-repeat"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Synchronization Service
                            </div>

                            <strong class="text-success">
                                @(IsRunning ? "Running" : "Operational")
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Auto Assignment -->

                <div class="col-md-4">

                    <div class="d-flex align-items-center">

                        <div class="status-icon @(Settings.AutoAssignmentEnabled
                                                                                                                                            ? "bg-success-subtle text-success"
                                                                                                                                            : "bg-secondary-subtle text-secondary")">

                            <i class="bi bi-person-check"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Automatic Assignment
                            </div>

                            <strong>
                                @(Settings.AutoAssignmentEnabled
                                    ? "Enabled"
                                    : "Disabled")
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Synchronization Interval -->

                <div class="col-md-4">

                    <div class="d-flex align-items-center">

                        <div class="status-icon bg-primary-subtle text-primary">

                            <i class="bi bi-clock-history"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Synchronization Interval
                            </div>

                            <strong>
                                @Settings.SynchronizationIntervalHours hours
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- SYNCHRONIZATION HISTORY -->
    <!-- ===================================================== -->
    <div class="card mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h6 class="mb-0">

                <i class="bi bi-clock-history me-2"></i>

                Synchronization History

            </h6>

            <button class="btn btn-sm btn-cidb-submit"
                    @onclick="OpenSynchronizationHistory">

                <i class="bi bi-list-ul me-1"></i>

                View All

            </button>

        </div>


        @if (Synchronizations?.Items.Any() == true)
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>Started</th>

                            <th>Completed</th>

                            <th>Type</th>

                            <th>Status</th>

                            <th>Retrieved</th>

                            <th>Compliant</th>

                            <th>Non-Compliant</th>

                            <th>Cases</th>

                            <th>Errors</th>

                            <th></th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var sync in Synchronizations.Items)
                        {
                            <tr>

                                <!-- Started -->

                                <td>

                                    <div class="fw-semibold">
                                        @sync.StartedOn.ToString("dd MMM yyyy")
                                    </div>

                                    <small class="text-muted">
                                        @sync.StartedOn.ToString("HH:mm")
                                    </small>

                                </td>


                                <!-- Completed -->

                                <td>

                                    @if (sync.CompletedOn.HasValue)
                                    {
                                        <div>
                                            @sync.CompletedOn.Value.ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @sync.CompletedOn.Value.ToString("HH:mm")
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- Type -->

                                <td>

                                    @if (sync.IsManual)
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-person me-1"></i>
                                            Manual
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-clock me-1"></i>
                                            Scheduled
                                        </span>
                                    }

                                </td>


                                <!-- Status -->

                                <td>

                                    @switch (sync.Status)
                                    {
                                        case SyncStatus.Completed:

                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1"></i>

                                                Completed

                                            </span>

                                            break;

                                        case SyncStatus.Running:

                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-arrow-repeat me-1"></i>

                                                Running

                                            </span>

                                            break;

                                        default:

                                            <span class="badge bg-danger">

                                                <i class="bi bi-x-circle me-1"></i>

                                                Failed

                                            </span>

                                            break;
                                    }

                                </td>


                                <!-- Retrieved -->

                                <td>
                                    @sync.TotalRetrieved
                                </td>


                                <!-- Compliant -->

                                <td>

                                    <span class="text-success fw-semibold">
                                        @sync.TotalCompliant
                                    </span>

                                </td>


                                <!-- Non-Compliant -->

                                <td>

                                    <span class="text-danger fw-semibold">
                                        @sync.TotalNonCompliant
                                    </span>

                                </td>


                                <!-- Cases -->

                                <td>

                                    <span class="fw-semibold">
                                        @sync.CasesCreated
                                    </span>

                                </td>


                                <!-- Errors -->

                                <td>

                                    @if (sync.ErrorCount > 0)
                                    {
                                        <span class="badge bg-danger">
                                            @sync.ErrorCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            0
                                        </span>
                                    }

                                </td>


                                <!-- Action -->

                                <td>

                                    <button class="btn btn-sm btn-cidb-submit"
                                            title="View synchronization details"
                                            @onclick="() => OpenSynchronization(sync.Id)">

                                        <i class="bi bi-eye me-1"></i>

                                        View

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">

                <i class="bi bi-clock-history display-5"></i>

                <p class="mt-3 mb-1">
                    No synchronization history found.
                </p>

                <small>
                    Synchronization activity will appear here after the first run.
                </small>

            </div>
        }

    </div>

    <!-- ===================================================== -->
    <!-- SYSTEM SETTINGS -->
    <!-- ===================================================== -->
    <div class="card mb-4">

        <div class="card-header">

            <h6 class="mb-0">

                <i class="bi bi-sliders me-2"></i>

                System Settings

            </h6>

        </div>


        <div class="card-body">

            @if (!_settingsLoaded || _settingsEditContext == null)
            {
                <div class="text-center text-muted py-5">

                    <div class="spinner-border" role="status"></div>

                    <p class="mt-3 mb-0">
                        Loading settings...
                    </p>

                </div>
            }
            else
            {

                <CascadingValue Value="_settingsEditContext">

                    <!-- CASE MANAGEMENT -->

                    <div class="settings-section">

                        <div class="settings-section-title">

                            <i class="bi bi-folder2-open me-2"></i>

                            Response Deadlines

                        </div>

                        <div class="row g-3">

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label">
                                    Instruction Letter Response
                                </label>

                                <div class="input-group">

                                    <InputNumber class="form-control"
                                                 @bind-Value="Settings.InstructionLetterResponseWorkingDays" />

                                    <span class="input-group-text">
                                        Working Days
                                    </span>

                                </div>

                                <div class="form-text">
                                    Time allowed for a client to respond to an Instruction Letter on an open tender. CIDB finalized rule: 2 working days.
                                </div>

                            </div>

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label">
                                    Closed Tender Response
                                </label>

                                <div class="input-group">

                                    <InputNumber class="form-control"
                                                 @bind-Value="Settings.ClosedTenderResponseDays" />

                                    <span class="input-group-text">
                                        Days
                                    </span>

                                </div>

                                <div class="form-text">
                                    Time allowed when a Contravention Notice is issued directly on a closed tender. Framework default: 14 days.
                                </div>

                            </div>

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label">
                                    Contravention Notice Response
                                </label>

                                <div class="input-group">

                                    <InputNumber class="form-control"
                                                 @bind-Value="Settings.ContraventionNoticeResponseDays" />

                                    <span class="input-group-text">
                                        Working Days
                                    </span>

                                </div>

                                <div class="form-text">
                                    Time allowed to respond once a Contravention Notice has been issued, including IL escalations. CIDB finalized rule: 14 working days.
                                </div>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- AGSA REFERRAL & ROP TIMING -->

                    <div class="settings-section">

                        <div class="settings-section-title">

                            <i class="bi bi-shield-exclamation me-2"></i>

                            AGSA Referral &amp; RoP Timing

                        </div>

                        <div class="row g-3">

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label">
                                    AGSA Referral Deadline
                                </label>

                                <div class="input-group">

                                    <InputNumber class="form-control"
                                                 @bind-Value="Settings.AgsaReferralDeadlineDays" />

                                    <span class="input-group-text">
                                        Days
                                    </span>

                                </div>

                                <div class="form-text">
                                    Absolute deadline from CO allocation, independent of the IL/CN cycle - anything still open past this is referred for
                                    enforcement automatically. CIDB finalized rule: 30 days.
                                </div>

                            </div>

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label">
                                    RoP Check Window
                                </label>

                                <div class="input-group">

                                    <InputNumber class="form-control"
                                                 @bind-Value="Settings.RopCheckAfterDays" />

                                    <span class="input-group-text">
                                        Days
                                    </span>

                                </div>

                                <div class="form-text">
                                    Days after a tender's closing date before RoP registration is checked at all, to allow the procurement/award process
                                    to complete. CIDB finalized rule: 90 days.
                                </div>

                            </div>

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label">
                                    RoP Registration Grace
                                </label>

                                <div class="input-group">

                                    <InputNumber class="form-control"
                                                 @bind-Value="Settings.RopRegistrationGraceDays" />

                                    <span class="input-group-text">
                                        Days
                                    </span>

                                </div>

                                <div class="form-text">
                                    Further grace period after the RoP check window before an unregistered award becomes a compliance matter. CIDB
                                    finalized rule: 21 days (111 days after closing in total).
                                </div>

                            </div>

                            <div class="col-lg-6">

                                <label class="form-label">
                                    AGSA Referral Email
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="Settings.AgsaReferralEmail" />

                                <div class="form-text">
                                    Recipient for the enforcement referral document.
                                </div>

                            </div>

                            <div class="col-lg-6">

                                <label class="form-label">
                                    CIDB Enforcement Unit Email (CC)
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="Settings.EnforcementUnitEmail" />

                                <div class="form-text">
                                    CC'd on every referral sent to AGSA.
                                </div>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- REMINDERS & ESCALATION -->

                    <div class="settings-section">

                        <div class="settings-section-title">

                            <i class="bi bi-bell me-2"></i>

                            Reminders &amp; Escalation

                        </div>

                        <div class="row g-3">

                            <div class="col-lg-4 col-md-6">

                                <div class="form-check form-switch mt-4">

                                    <InputCheckbox class="form-check-input"
                                                   @bind-Value="Settings.EnableAutomaticReminders" />

                                    <label class="form-check-label">
                                        Send Automatic Reminders
                                    </label>

                                </div>

                                <div class="form-text">
                                    Whether the system automatically sends a reminder letter before a deadline is escalated.
                                </div>

                            </div>

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label">
                                    Reminder Sent After
                                </label>

                                <div class="input-group">

                                    <InputNumber class="form-control"
                                                 @bind-Value="Settings.ReminderAfterWorkingDays" />

                                    <span class="input-group-text">
                                        Working Days
                                    </span>

                                </div>

                                <div class="form-text">
                                    Working days into whichever letter (IL or CN) is currently outstanding before a reminder goes out. CIDB finalized rule: day 7.
                                </div>

                            </div>

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label">
                                    Automation Check Interval
                                </label>

                                <div class="input-group">

                                    <InputNumber class="form-control"
                                                 @bind-Value="Settings.ReminderCheckIntervalMinutes" />

                                    <span class="input-group-text">
                                        Minutes
                                    </span>

                                </div>

                                <div class="form-text">
                                    How often the background job checks for reminders to send and cases to escalate. Takes effect on the next check, not immediately.
                                </div>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- APPROVAL WORKFLOW -->

                    <div class="settings-section">

                        <div class="settings-section-title">

                            <i class="bi bi-patch-check me-2"></i>

                            Approval Workflow

                        </div>

                        <div class="row g-3">

                            <div class="col-lg-6">

                                <div class="form-check form-switch mt-1">

                                    <InputCheckbox class="form-check-input"
                                                   @bind-Value="Settings.RequireManagerApproval" />

                                    <label class="form-check-label">
                                        Require Manager Approval Before Sending
                                    </label>

                                </div>

                                <div class="form-text">
                                    When on, Instruction Letters and Contravention Notices are routed to a Manager
                                    for e-signature via SigningHub before they are emailed to the client. Requires at
                                    least one Agent flagged as Manager, and SigningHub to be configured - otherwise
                                    letters fall back to sending immediately and a warning is logged.
                                </div>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- SYNCHRONIZATION -->

                    <div class="settings-section">

                        <div class="settings-section-title">

                            <i class="bi bi-arrow-repeat me-2"></i>

                            Synchronization

                        </div>

                        <div class="row g-3">

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label">
                                    Synchronization Interval
                                </label>

                                <div class="input-group">

                                    <InputNumber class="form-control"
                                                 @bind-Value="Settings.SynchronizationIntervalHours" />

                                    <span class="input-group-text">
                                        Hours
                                    </span>

                                </div>

                                <div class="form-text">
                                    Frequency of scheduled tender synchronization.
                                </div>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- CASE ASSIGNMENT -->

                    <div class="settings-section">

                        <div class="settings-section-title">

                            <i class="bi bi-people me-2"></i>

                            Case Assignment

                        </div>

                        <div class="row g-3">

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label">
                                    Distribution Method
                                </label>

                                <InputSelect class="form-select"
                                             @bind-Value="Settings.DistributionMethod">

                                    @foreach (var method in Enum.GetValues<CaseDistributionMethod>())
                                    {
                                        <option value="@method">
                                            @method
                                        </option>
                                    }

                                </InputSelect>

                                <div class="form-text">
                                    @GetDistributionMethodDescription(
                                        Settings.DistributionMethod)
                                </div>

                            </div>


                            <div class="col-lg-4 col-md-6 d-flex align-items-center">

                                <div>

                                    <div class="form-check form-switch">

                                        <InputCheckbox class="form-check-input"
                                                       @bind-Value="Settings.AutoAssignmentEnabled" />

                                        <label class="form-check-label fw-semibold">
                                            Automatic Assignment
                                        </label>

                                    </div>

                                    <div class="form-text ms-5">

                                        Automatically assign newly created cases
                                        to eligible compliance officers.

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- PAGINATION -->

                    <div class="settings-section">

                        <div class="settings-section-title">

                            <i class="bi bi-list-ol me-2"></i>

                            Pagination

                        </div>

                        <div class="row g-3">

                            <div class="col-lg-4 col-md-6">

                                <label class="form-label">
                                    Default Page Size
                                </label>

                                <InputNumber class="form-control"
                                             @bind-Value="Settings.DefaultPageSize" />

                                <div class="form-text">
                                    Number of records displayed per page by default.
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- SAVE -->

                    <div class="d-flex justify-content-end mt-4">

                        <button class="btn btn-sm btn-cidb-submit"
                                @onclick="SaveSettings">

                            <i class="bi bi-check2 me-2"></i>

                            Save Settings

                        </button>

                    </div>

                </CascadingValue>

            }

        </div>

    </div>
</div>

