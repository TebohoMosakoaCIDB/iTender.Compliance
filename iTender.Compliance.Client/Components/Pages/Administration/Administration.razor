@code {
    private bool _runningReminders;
    private bool _runningEscalation;
    private bool _runningSigningPoll;
    private string? _triggerResultMessage;
    private bool _triggerResultIsError;

    private async Task RunRemindersNow()
    {
        _runningReminders = true;
        _triggerResultMessage = null;
        StateHasChanged();

        try
        {
            var count = await ReminderService.ProcessRemindersAsync();

            _triggerResultIsError = false;
            _triggerResultMessage = count == 0
                ? "Reminders pass complete - nothing was due."
                : $"Reminders pass complete - {count} reminder letter(s) sent.";
        }
        catch (Exception ex)
        {
            _triggerResultIsError = true;
            _triggerResultMessage = $"Reminders pass failed: {ex.Message}";
        }
        finally
        {
            _runningReminders = false;
        }
    }

    private async Task RunEscalationNow()
    {
        _runningEscalation = true;
        _triggerResultMessage = null;
        StateHasChanged();

        try
        {
            var toCn = await EscalationService.EscalateOverdueInstructionLettersAsync();
            var toAgsa = await EscalationService.EscalateOverdueContraventionNoticesAsync();
            var toAgsaStale = await EscalationService.EscalateStaleCasesToAgsaAsync();

            _triggerResultIsError = false;
            _triggerResultMessage =
                $"Escalation pass complete - {toCn} case(s) escalated to a Contravention Notice, " +
                $"{toAgsa} case(s) referred for enforcement after an overdue CN, " +
                $"{toAgsaStale} case(s) referred on the 30-day absolute deadline.";
        }
        catch (Exception ex)
        {
            _triggerResultIsError = true;
            _triggerResultMessage = $"Escalation pass failed: {ex.Message}";
        }
        finally
        {
            _runningEscalation = false;
        }
    }

    private async Task RunSigningPollNow()
    {
        _runningSigningPoll = true;
        _triggerResultMessage = null;
        StateHasChanged();

        try
        {
            var result = await DocumentSigningService.PollAndCompleteAsync();

            foreach (var caseLetterId in result.CompletedCaseLetterIds)
            {
                await CorrespondenceService.CompleteApprovedLetterAsync(caseLetterId);
            }

            foreach (var rejected in result.RejectedLetters)
            {
                await CorrespondenceService.HandleRejectedLetterAsync(
                    rejected.CaseLetterId,
                    rejected.Reason);
            }

            _triggerResultIsError = false;
            _triggerResultMessage =
                $"SigningHub poll complete - {result.CompletedCaseLetterIds.Count} letter(s) signed and delivered, " +
                $"{result.RejectedLetters.Count} rejected.";
        }
        catch (Exception ex)
        {
            _triggerResultIsError = true;
            _triggerResultMessage = $"SigningHub poll failed: {ex.Message}";
        }
        finally
        {
            _runningSigningPoll = false;
        }
    }


    private bool ShowSyncDetailModal;

    private TenderSyncDetailModel? SelectedSynchronization;

    private bool ShowErrorMessage;

    private string ErrorMessage = string.Empty;

    private bool ShowSuccessMessage;

    private string SuccessMessage = string.Empty;

    private SystemSettingModel Settings = new();

    private EditContext? _settingsEditContext;

    private bool _settingsLoaded;

    private SyncReportModel Model = new();

    private PagedResult<TenderSync>? Synchronizations;

    private TenderSyncSearchModel Search = new();

    private bool IsRunning;


    protected override async Task OnInitializedAsync()
    {
        Model =
            await ReportingService.GetSynchronizationReportAsync(
                DateTime.MinValue,
                DateTime.UtcNow);

        Search = new TenderSyncSearchModel
        {
            PageNumber = 1,
            PageSize = 5
        };

        Synchronizations =
            await TenderSyncRepository.SearchAsync(Search);

        Settings =
            await SettingService.GetAsync();

        _settingsEditContext = new EditContext(Settings);
        _settingsLoaded = true;
    }


    private async Task RunSynchronization()
    {
        ShowErrorMessage = false;
        ShowSuccessMessage = false;

        IsRunning = true;

        await InvokeAsync(StateHasChanged);

        try
        {
            await SynchronizationService.SynchronizeAsync(true);

            Model =
                await ReportingService.GetSynchronizationReportAsync(
                    DateTime.MinValue,
                    DateTime.UtcNow);

            SuccessMessage =
                "Tender synchronization completed.";

            ShowSuccessMessage = true;
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"Synchronization failed: {ex.Message}";

            ShowErrorMessage = true;
        }
        finally
        {
            IsRunning = false;

            Synchronizations =
                await TenderSyncRepository.SearchAsync(Search);

            Settings =
                await SettingService.GetAsync();

            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task SaveSettings()
    {
        ShowErrorMessage = false;
        ShowSuccessMessage = false;

        try
        {
            await SettingService.SaveAsync(Settings);

            SuccessMessage = "System settings saved successfully.";
            ShowSuccessMessage = true;

            await InvokeAsync(StateHasChanged);

            await Task.Delay(1000);

            Navigation.NavigateTo("/administration", forceLoad: true);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to save system settings: {ex.Message}";
            ShowErrorMessage = true;

            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task OpenSynchronization(Guid id)
    {
        SelectedSynchronization =
            await LogRepository.GetDetailAsync(id);

        ShowSyncDetailModal =
            SelectedSynchronization != null;
    }


    private void CloseSynchronization()
    {
        ShowSyncDetailModal = false;

        SelectedSynchronization = null;
    }


    private void OpenSynchronizationHistory()
    {
        Navigation.NavigateTo(
            "/administration/synchronizations");
    }


    private static string GetDistributionMethodDescription(
        CaseDistributionMethod method)
    {
        return method switch
        {
            CaseDistributionMethod.Manual =>
                "Cases are not assigned automatically. Supervisors assign each case manually.",

            CaseDistributionMethod.RoundRobin =>
                "Cases are distributed evenly by assigning each new case to the next available agent in sequence.",

            CaseDistributionMethod.LeastWorkload =>
                "Each new case is assigned to the eligible agent with the fewest open cases.",

            CaseDistributionMethod.Random =>
                "A random eligible agent is selected for each new case.",

            CaseDistributionMethod.PriorityBased =>
                "Cases are assigned based on priority rules, ensuring high-priority cases are handled by the most appropriate agents.",

            _ => string.Empty
        };
    }

}