<!-- SYNCHRONIZATION DETAIL MODAL -->
<!-- ========================================================= -->
@if (ShowSyncDetailModal && SelectedSynchronization != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color:rgba(0,0,0,.5)">

        <div class="modal-dialog modal-xl modal-dialog-scrollable">

            <div class="modal-content">


                <!-- HEADER -->

                <div class="modal-header">

                    <h5 class="modal-title">

                        <i class="bi bi-clock-history me-2"></i>

                        Synchronization Details

                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseSynchronization">
                    </button>

                </div>


                <!-- BODY -->

                <div class="modal-body">


                    <!-- SUMMARY -->

                    <div class="row g-3 mb-4">

                        <div class="col-md-3">

                            <div class="border rounded p-3 h-100">

                                <small class="text-muted d-block">
                                    Started
                                </small>

                                <strong>
                                    @SelectedSynchronization.StartedOn.ToString("dd MMM yyyy HH:mm")
                                </strong>

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="border rounded p-3 h-100">

                                <small class="text-muted d-block">
                                    Completed
                                </small>

                                <strong>

                                    @(SelectedSynchronization.CompletedOn?
                                        .ToString("dd MMM yyyy HH:mm") ?? "-")

                                </strong>

                            </div>

                        </div>


                        <div class="col-md-2">

                            <div class="border rounded p-3 text-center h-100">

                                <small class="text-muted d-block">
                                    Retrieved
                                </small>

                                <h4 class="mb-0">
                                    @SelectedSynchronization.TotalRetrieved
                                </h4>

                            </div>

                        </div>


                        <div class="col-md-2">

                            <div class="border rounded p-3 text-center h-100">

                                <small class="text-muted d-block">
                                    Cases
                                </small>

                                <h4 class="mb-0 text-warning">
                                    @SelectedSynchronization.CasesCreated
                                </h4>

                            </div>

                        </div>


                        <div class="col-md-2">

                            <div class="border rounded p-3 text-center h-100">

                                <small class="text-muted d-block">
                                    Errors
                                </small>

                                <h4 class="mb-0
                                    @(SelectedSynchronization.ErrorCount > 0
                                        ? "text-danger"
                                        : "text-success")">

                                    @SelectedSynchronization.ErrorCount

                                </h4>

                            </div>

                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="mb-4">

                        <div class="d-flex align-items-center gap-2">

                            <span class="text-muted">
                                Status:
                            </span>

                            @if (SelectedSynchronization.ErrorCount > 0)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Errors Detected
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Completed Successfully
                                </span>
                            }

                        </div>

                    </div>


                    <hr />


                    <!-- TIMELINE -->

                    <h6 class="mb-4">

                        <i class="bi bi-list-check me-2"></i>

                        Synchronization Timeline

                    </h6>


                    @if (SelectedSynchronization.Logs.Any())
                    {
                        <div class="sync-timeline">

                            @foreach (var log in SelectedSynchronization.Logs)
                            {
                                <div class="sync-timeline-item">

                                    <div class="sync-timeline-icon">

                                        @switch (log.Level)
                                        {
                                            case SyncLogLevel.Information:

                                                <i class="bi bi-info-circle-fill text-primary"></i>

                                                break;

                                            case SyncLogLevel.Warning:

                                                <i class="bi bi-exclamation-circle-fill text-warning"></i>

                                                break;

                                            case SyncLogLevel.Error:

                                                <i class="bi bi-x-circle-fill text-danger"></i>

                                                break;
                                        }

                                    </div>


                                    <div class="sync-timeline-content">

                                        <div class="d-flex justify-content-between align-items-start">

                                            <strong>
                                                @log.Title
                                            </strong>

                                            <small class="text-muted ms-3">

                                                @log.Date.ToString(
                                                    "dd MMM yyyy HH:mm:ss")

                                            </small>

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(log.TenderNumber))
                                        {
                                            <div class="text-primary fw-semibold mt-1">

                                                <i class="bi bi-file-earmark-text me-1"></i>

                                                @log.TenderNumber

                                            </div>
                                        }


                                        <div class="mt-1 text-muted">
                                            @log.Message
                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">

                            <i class="bi bi-clock-history display-5"></i>

                            <p class="mt-3 mb-0">
                                No synchronization logs were recorded.
                            </p>

                        </div>
                    }

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            @onclick="CloseSynchronization">

                        <i class="bi bi-x-circle me-2"></i>

                        Close

                    </button>

                </div>

            </div>

        </div>

    </div>
}


