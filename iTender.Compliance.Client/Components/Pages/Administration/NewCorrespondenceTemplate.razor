@page "/correspondence/create"

@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using iTender.Compliance.Domain.Entities
@using iTender.Compliance.Domain.Enums
@using iTender.Compliance.Application.Interfaces.Services

@attribute [Authorize(Policy = "CorrespondenceDraft")]

@inject ICorrespondenceTemplateService TemplateService
@inject NavigationManager Navigation

<PageTitle>Templates | CRCIP Monitor</PageTitle>

<div class="container-fluid">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">

                <i class="bi bi-file-earmark-plus me-2 text-secondary"></i>

                New Correspondence Template

            </h2>

            <small class="text-muted">
                Create a new correspondence template for the compliance process.
            </small>

        </div>

        <button class="btn btn-sm btn-secondary"
                @onclick="Cancel">

            <i class="bi bi-arrow-left me-2"></i>

            Back

        </button>

    </div>


    <!-- ===================================================== -->
    <!-- ERROR -->
    <!-- ===================================================== -->
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @ErrorMessage

        </div>
    }


    <!-- ===================================================== -->
    <!-- FORM -->
    <!-- ===================================================== -->

    <div class="row g-4">

        <!-- ================================================= -->
        <!-- TEMPLATE DETAILS -->
        <!-- ================================================= -->

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header bg-white">

                    <strong>

                        <i class="bi bi-file-earmark-text me-2"></i>

                        Template Details

                    </strong>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <!-- NAME -->

                        <div class="col-md-8">

                            <label class="form-label">
                                Template Name
                            </label>

                            <input type="text"
                                   class="form-control"
                                   @bind="Template.Name"
                                   placeholder="e.g. Instructional Letter" />

                        </div>


                        <!-- TYPE -->

                        <div class="col-md-4">

                            <label class="form-label">
                                Template Type
                            </label>

                            <select class="form-select"
                                    @bind="Template.Type">

                                <option value="">
                                    Select Type
                                </option>

                                @foreach (var type in Enum.GetValues<CorrespondenceTemplateType>())
                                {
                                    <option value="@type">
                                        @GetTypeName(type)
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- SUBJECT -->

                        <div class="col-12">

                            <label class="form-label">
                                Subject
                            </label>

                            <input type="text"
                                   class="form-control"
                                   @bind="Template.Subject"
                                   placeholder="Correspondence subject" />

                            <div class="form-text">

                                You can use template variables such as
                                <code>{TenderNumber}</code> and
                                <code>{ClientName}</code>.

                            </div>

                        </div>


                        <!-- BODY -->

                        <div class="col-12">

                            <label class="form-label">
                                Template Body
                            </label>

                            <textarea class="form-control"
                                      rows="18"
                                      @bind="Template.Body"
                                      placeholder="Enter the correspondence template...">
                            </textarea>

                            <div class="form-text">

                                Template variables can be inserted into the
                                correspondence body.

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- TEMPLATE INFORMATION -->
        <!-- ================================================= -->

        <div class="col-lg-4">

            <div class="card shadow-sm mb-4">

                <div class="card-header bg-white">

                    <strong>

                        <i class="bi bi-info-circle me-2"></i>

                        Template Information

                    </strong>

                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <small class="text-muted d-block">
                            Status
                        </small>

                        <span class="badge bg-secondary">
                            Draft
                        </span>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted d-block">
                            Version
                        </small>

                        <strong>
                            Version 1
                        </strong>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted d-block">
                            Created
                        </small>

                        <strong>
                            @DateTime.UtcNow.ToString("dd MMM yyyy HH:mm")
                        </strong>

                    </div>


                    <div>

                        <small class="text-muted d-block">
                            Active
                        </small>

                        <span class="badge bg-success">
                            Yes
                        </span>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- AVAILABLE VARIABLES -->
            <!-- ================================================= -->

            <div class="card shadow-sm">

                <div class="card-header bg-white">

                    <strong>

                        <i class="bi bi-braces me-2"></i>

                        Available Variables

                    </strong>

                </div>

                <div class="card-body">

                    <p class="small text-muted">
                        These placeholders can be used in the subject and body.
                        They will be replaced with actual case information when
                        correspondence is generated.
                    </p>


                    <div class="mb-2">

                        <code>{TenderNumber}</code>

                        <small class="text-muted ms-2">
                            Tender number
                        </small>

                    </div>


                    <div class="mb-2">

                        <code>{TenderTitle}</code>

                        <small class="text-muted ms-2">
                            Tender title
                        </small>

                    </div>


                    <div class="mb-2">

                        <code>{ClientName}</code>

                        <small class="text-muted ms-2">
                            Client / employer
                        </small>

                    </div>


                    <div class="mb-2">

                        <code>{AdvertisedDate}</code>

                        <small class="text-muted ms-2">
                            Advertisement date
                        </small>

                    </div>


                    <div class="mb-2">

                        <code>{ClosingDate}</code>

                        <small class="text-muted ms-2">
                            Tender closing date
                        </small>

                    </div>


                    <div class="mb-2">

                        <code>{ResponseDueDate}</code>

                        <small class="text-muted ms-2">
                            Response deadline
                        </small>

                    </div>


                    <div class="mb-2">

                        <code>{AgentName}</code>

                        <small class="text-muted ms-2">
                            Compliance officer
                        </small>

                    </div>


                    <div class="mb-2">

                        <code>{AgentSignature}</code>

                        <small class="text-muted ms-2">
                            Officer signature
                        </small>

                    </div>


                    <div>

                        <code>{FooterText}</code>

                        <small class="text-muted ms-2">
                            Standard footer
                        </small>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- ACTIONS -->
    <!-- ===================================================== -->

    <div class="card shadow-sm mt-4">

        <div class="card-body d-flex justify-content-between align-items-center">

            <div>

                <strong>
                    Save Template
                </strong>

                <div class="small text-muted">
                    The template will be saved as a draft and will require
                    approval before it can be used.
                </div>

            </div>

            <div>

                <button class="btn btn-sm btn-secondary me-2"
                        @onclick="Cancel"
                        disabled="@IsSaving">

                    Cancel

                </button>


                <button class="btn btn-sm btn-cidb-submit"
                        @onclick="Save"
                        disabled="@IsSaving">

                    @if (IsSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>

                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-save me-2"></i>

                        <span>Save Draft</span>
                    }

                </button>

            </div>

        </div>

    </div>

</div>


@code {

    private CorrespondenceTemplateModel Template = new()
    {
        IsActive = true,
        Status = CorrespondenceTemplateStatus.Draft,
        Version = 1,
        CreatedOn = DateTime.UtcNow
    };


    private bool IsSaving;

    private string ErrorMessage = string.Empty;


    private async Task Save()
    {
        ErrorMessage = string.Empty;


        // ============================================
        // VALIDATION
        // ============================================

        if (string.IsNullOrWhiteSpace(Template.Name))
        {
            ErrorMessage = "Template name is required.";
            return;
        }


        if (string.IsNullOrWhiteSpace(Template.Subject))
        {
            ErrorMessage = "Template subject is required.";
            return;
        }


        if (string.IsNullOrWhiteSpace(Template.Body))
        {
            ErrorMessage = "Template body is required.";
            return;
        }


        IsSaving = true;


        try
        {
            Template.Id = Guid.NewGuid();

            Template.Status =
                CorrespondenceTemplateStatus.Draft;

            Template.Version = 1;

            Template.IsActive = true;

            Template.CreatedOn =
                DateTime.UtcNow;


            await TemplateService.CreateAsync(Template);


            Navigation.NavigateTo("/correspondence");

        }
        catch (Exception ex)
        {
            ErrorMessage =
                "Unable to save the template: "
                + ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }


    private void Cancel()
    {
        Navigation.NavigateTo("/correspondence");
    }


    private static string GetTypeName(
        CorrespondenceTemplateType type)
    {
        return type switch
        {
            CorrespondenceTemplateType.InstructionalLetter =>
                "Instructional Letter",

            CorrespondenceTemplateType.ContraventionNotice =>
                "Contravention Notice",

            _ =>
                type.ToString()
        };
    }

}