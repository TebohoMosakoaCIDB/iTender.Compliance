@page "/correspondence-templates/new"
@using Microsoft.AspNetCore.Authorization
@using iTender.Compliance.Application.Interfaces.Services
@using iTender.Compliance.Domain.Enums
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Administration")]


@inject ICorrespondenceTemplateService TemplateService
@inject NavigationManager Navigation

@inject ICorrespondenceTemplateService TemplateService
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-0">
            <i class="bi bi-envelope-plus-fill me-2 text-secondary"></i>
            Create Correspondence Template
        </h2>

        <small class="text-muted">
            Select the correspondence template you would like to configure.
        </small>

    </div>

    <button class="btn btn-outline-secondary"
            @onclick="Back">

        <i class="bi bi-arrow-left me-2"></i>

        Back

    </button>

</div>

<hr />

@if (!AvailableTypes.Any())
{
    <div class="alert alert-success d-flex align-items-center">

        <i class="bi bi-check-circle-fill me-2 fs-4"></i>

        <div>

            <strong>All templates have been configured.</strong>

            <div class="small">
                Every correspondence template has already been created. You can edit them from the Templates page.
            </div>

        </div>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var type in AvailableTypes)
        {
            <div class="col-md-6 col-xl-4">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body d-flex flex-column">

                        <div class="mb-3">

                            <h5 class="card-title mb-1">

                                @GetDisplayName(type)

                            </h5>

                            <small class="text-muted">

                                @type

                            </small>

                        </div>

                        <p class="text-muted flex-grow-1">

                            @GetDescription(type)

                        </p>

                        <button class="btn btn-cidb-submit mt-auto"
                                @onclick="() => Create(type)">

                            <i class="bi bi-plus-circle me-2"></i>

                            Create Template

                        </button>

                    </div>

                </div>

            </div>
        }

    </div>
}

@code
{
    private List<CorrespondenceTemplateType> AvailableTypes = [];

    protected override async Task OnInitializedAsync()
    {
        var templates = await TemplateService.GetAllAsync();

        AvailableTypes = Enum
            .GetValues<CorrespondenceTemplateType>()
            .Except(templates.Select(x => x.Type))
            .ToList();
    }

    private static string GetDescription(
        CorrespondenceTemplateType type)
    {
        return type switch
        {
            CorrespondenceTemplateType.InstructionLetter =>
                "Sent when a compliance case is assigned.",

            CorrespondenceTemplateType.ReminderLetter =>
                "Sent when no response has been received.",

            CorrespondenceTemplateType.CaseClosed =>
                "Sent to notify an agent of a Case Closed.",

            _ => ""
        };
    }

    private async Task Create(
        CorrespondenceTemplateType type)
    {
        var id = await TemplateService.CreateAsync(type);

        Navigation.NavigateTo(
            $"/correspondence-templates/{id}");
    }

    private static string GetDisplayName(CorrespondenceTemplateType type)
    {
        return type switch
        {
            CorrespondenceTemplateType.InstructionLetter => "Instruction Letter",

            CorrespondenceTemplateType.ReminderLetter => "Reminder Letter",

            CorrespondenceTemplateType.CaseClosed => "Case Closed",

            _ => type.ToString()
        };
    }

    private void Back()
    {
        Navigation.NavigateTo("/correspondence-templates");
    }
}