@page "/correspondence-templates/{Id:guid}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Administration")]

@using iTender.Compliance.Application.DTOs
@using iTender.Compliance.Application.Interfaces.Services

@inject ICorrespondenceTemplateService TemplateService
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-0">
            <i class="bi bi-envelope-paper-fill me-2 text-secondary"></i>
            Edit Correspondence Template
        </h2>

        <small class="text-muted">
            Configure the correspondence template used by the compliance system.
        </small>

    </div>

</div>

<hr />

@if (Model == null)
{
    <div class="text-center py-5">

        <div class="spinner-border text-primary"></div>

    </div>
}
else
{
    <div class="row">
        <div class="col-lg-7">
            <EditForm Model="Model"
                      OnValidSubmit="Save">

                <DataAnnotationsValidator />

                <ValidationSummary />

                <div class="card shadow-sm mb-4">

                    <div class="card-header">

                        <strong>General Information</strong>

                    </div>

                    <div class="card-body">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Template Name
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="Model.Name" />

                            </div>

                            <div class="col-md-6">

                                <label class="form-label">
                                    Template Type
                                </label>

                                <input class="form-control"
                                       value="@Model.Type.ToString()"
                                       readonly />

                            </div>

                            <div class="col-md-6">

                                <div class="form-check mt-4">

                                    <InputCheckbox class="form-check-input"
                                                   @bind-Value="Model.IsActive" />

                                    <label class="form-check-label">

                                        Active Template

                                    </label>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="card shadow-sm mb-4">

                    <div class="card-header">

                        <strong>Email Details</strong>

                    </div>

                    <div class="card-body">

                        <label class="form-label">

                            Subject

                        </label>

                        <InputText class="form-control"
                                   @bind-Value="Model.Subject" />

                    </div>

                </div>

                <div class="card shadow-sm mb-4">

                    <div class="card-header">

                        <strong>Header Image</strong>

                    </div>

                    <div class="card-body">

                        <label class="form-label">

                            Header Image Path

                        </label>

                        <InputText class="form-control"
                                   @bind-Value="Model.HeaderImagePath" />

                        @if (!string.IsNullOrWhiteSpace(Model.HeaderImagePath))
                        {
                            <div class="mt-3">

                                <img src="@Model.HeaderImagePath"
                                     class="img-thumbnail"
                                     style="max-height:180px;" />

                            </div>
                        }

                    </div>

                </div>

                <div class="card shadow-sm mb-4">

                    <div class="card-header">

                        <strong>Template Body</strong>

                    </div>

                    <div class="card-body">

                        <InputTextArea class="form-control"
                                       rows="18"
                                       @bind-Value="Model.Body" />

                    </div>

                </div>

                <div class="card shadow-sm mb-4">

                    <div class="card-header">

                        <strong>Available Merge Fields</strong>

                    </div>

                    <div class="card-body">

                        <div class="row">

                            @foreach (var field in MergeFields)
                            {
                                <div class="col-md-4 mb-2">

                                    <code>@field</code>

                                </div>
                            }

                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="Back">

                        Cancel

                    </button>

                    <button class="btn btn-cidb-submit"
                            type="submit">

                        <i class="bi bi-check-circle me-2"></i>

                        Save Template

                    </button>

                </div>

            </EditForm>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm">

                <div class="card-header">

                    <strong>
                        Live Preview
                    </strong>

                </div>

                <div class="card-body">

                    @if (!string.IsNullOrWhiteSpace(Model.HeaderImagePath))
                    {
                        <img src="@Model.HeaderImagePath"
                             class="img-fluid rounded mb-4" />
                    }

                    <h4>

                        @Model.Subject

                    </h4>

                    <hr />

                    <div style="white-space:pre-wrap;">

                        @PreviewBody

                    </div>

                </div>

            </div>
        </div>

    </div>

    
}

@code
{
    [Parameter]
    public Guid Id { get; set; }

    private SaveCorrespondenceTemplateModel? Model;

    private readonly List<string> MergeFields =
    [
        "{AgentName}",
        "{CompanyName}",
        "{EmployerName}",
        "{TenderNumber}",
        "{TenderTitle}",
        "{CaseReference}",
        "{ResponseDueDate}",
        "{PortalUrl}",
        "{CurrentDate}"
    ];

    protected override async Task OnInitializedAsync()
    {
        var template = await TemplateService.GetByIdAsync(Id);

        if (template == null)
        {
            Navigation.NavigateTo("/correspondence-templates");
            return;
        }

        Model = new SaveCorrespondenceTemplateModel
        {
            Id = template.Id,
            Name = template.Name,
            Subject = template.Subject,
            Body = template.Body,
            Type = template.TemplateType,
            IsActive = template.IsActive,
            HeaderImagePath = template.HeaderImagePath
        };
    }

    private async Task Save()
    {
        if (Model == null)
            return;

        await TemplateService.UpdateAsync(Model);

        Navigation.NavigateTo("/correspondence-templates");
    }

    private void Back()
    {
        Navigation.NavigateTo("/correspondence-templates");
    }

    private string PreviewBody
    {
        get
        {
            if (Model == null)
                return "";

            return Model.Body
                .Replace("{CompanyName}", "ABC Construction (Pty) Ltd")
                .Replace("{TenderNumber}", "CIDB-2026-001")
                .Replace("{TenderTitle}", "Construction of Office Complex")
                .Replace("{EmployerName}", "City of Johannesburg")
                .Replace("{AgentName}", "John Smith")
                .Replace("{CaseReference}", "COMP-000123")
                .Replace("{ResponseDueDate}", DateTime.Today.AddDays(48).ToString("dd MMM yyyy"))
                .Replace("{PortalUrl}", "https://compliance.company.co.za")
                .Replace("{CurrentDate}", DateTime.Today.ToString("dd MMM yyyy"));
        }
    }
}