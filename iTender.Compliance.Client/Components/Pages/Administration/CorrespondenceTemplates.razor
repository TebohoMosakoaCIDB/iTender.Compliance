@page "/correspondence-templates"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@attribute [Authorize(Policy = "Administration")]

@using iTender.Compliance.Application.DTOs
@using iTender.Compliance.Application.Interfaces.Services

@inject ICorrespondenceTemplateService TemplateService

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-0">
            <i class="bi bi-envelope-paper-fill me-2 text-secondary"></i>
            Correspondence Templates
        </h2>

        <small class="text-muted">
            Manage email and PDF templates used by the compliance system.
        </small>

    </div>

    <button class="btn btn-cidb-submit"
            @onclick="Create">

        <i class="bi bi-plus-circle me-2"></i>

        New Template

    </button>

</div>

@if (Templates == null)
{
    <div class="text-center py-5">

        <div class="spinner-border text-secondary"></div>

    </div>
}
else if (!Templates.Any())
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">

        <div>

            <i class="bi bi-info-circle-fill me-2"></i>

            No correspondence templates have been created yet.

        </div>

        <button class="btn btn-sm btn-cidb-submit"
                @onclick="Create">

            <i class="bi bi-plus-circle me-2"></i>

            Create Template

        </button>

    </div>
}
else
{
    <table class="table table-hover align-middle">

        <thead>

            <tr>
                <th>Template</th>
                <th>Type</th>
                <th>Status</th>
                <th class="text-end" style="width:120px"></th>
            </tr>

        </thead>

        <tbody>

            @foreach (var template in Templates)
            {
                <tr>

                    <td>
                        <strong>@template.Name</strong>
                    </td>

                    <td>
                        @template.Type
                    </td>

                    <td>

                        @if (template.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }

                    </td>

                    <td class="text-end">

                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => Edit(template.Id)">

                            <i class="bi bi-pencil-square me-1"></i>

                            Edit

                        </button>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}

@code
{
    private List<CorrespondenceTemplateListModel> Templates = [];

    protected override async Task OnInitializedAsync()
    {
        Templates = await TemplateService.GetAllAsync();
    }

    private void Edit(Guid id)
    {
        Navigation.NavigateTo(
            $"/correspondence-templates/{id}");
    }

    private void Create()
    {
        Navigation.NavigateTo("/correspondence-templates/new");
    }
}