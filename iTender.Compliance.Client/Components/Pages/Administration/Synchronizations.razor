@page "/administration/synchronizations"
@rendermode InteractiveServer

@using iTender.Compliance.Application.DTOs
@using iTender.Compliance.Application.Interfaces.Repositories
@using iTender.Compliance.Domain.Entities
@using iTender.Compliance.Domain.Enums

@inject ITenderSyncLogRepository LogRepository
@inject ITenderSyncRepository TenderSyncRepository
@inject NavigationManager Navigation

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrator")]

<h2 class="mb-0">
    <i class="bi bi-clock-history me-2 text-secondary"></i>
    Synchronization History
</h2>

<small class="text-muted">
    View all manual and scheduled synchronization runs.
</small>

<div class="card shadow-sm mt-4 mb-4">

    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-3">

                <label class="form-label">
                    Status
                </label>

                <select class="form-select"
                        @bind="Search.Status">

                    <option value="">All</option>

                    @foreach (var status in Enum.GetValues<SyncStatus>())
                    {
                        <option value="@status">@status</option>
                    }

                </select>

            </div>

            <div class="col-md-3">

                <label class="form-label">
                    Synchronization
                </label>

                <select class="form-select"
                        @bind="Search.IsManual">

                    <option value="">All</option>
                    <option value="true">Manual</option>
                    <option value="false">Scheduled</option>

                </select>

            </div>

            <div class="col-md-3">

                <label class="form-label">
                    From Date
                </label>

                <input type="date"
                       class="form-control"
                       @bind="Search.FromDate" />

            </div>

            <div class="col-md-3">

                <label class="form-label">
                    To Date
                </label>

                <input type="date"
                       class="form-control"
                       @bind="Search.ToDate" />

            </div>

        </div>

        <hr />

        <div class="d-flex justify-content-between align-items-end">

            <div class="d-flex align-items-center gap-2">

                <label class="form-label mb-0">
                    Page Size
                </label>

                <select class="form-select"
                        style="width:100px"
                        @bind="Search.PageSize">

                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>

                </select>

            </div>

            <div class="d-flex gap-2">

                <button class="btn btn-secondary"
                        @onclick="ResetFilters">

                    <i class="bi bi-arrow-counterclockwise me-1"></i>

                    Clear

                </button>

                <button class="btn btn-cidb-submit"
                        @onclick="SearchSynchronizations">

                    <i class="bi bi-search me-1"></i>

                    Search

                </button>

            </div>

        </div>

    </div>

</div>

@if (Result == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-danger"></div>
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">

        <thead class="table-header-brand">

            <tr>

                <th>Started</th>
                <th>Completed</th>
                <th>Type</th>
                <th>Retrieved</th>
                <th>Compliant</th>
                <th>Non-Compliant</th>
                <th>Cases</th>
                <th>Status</th>
                <th style="width:120px;"></th>

            </tr>

        </thead>

        <tbody>

            @if (!Result.Items.Any())
            {
                <tr>

                    <td colspan="9"
                        class="text-center text-muted">

                        No synchronization history found.

                    </td>

                </tr>
            }
            else
            {
                @foreach (var sync in Result.Items)
                {
                    <tr>

                        <td>
                            @sync.StartedOn.ToString("dd MMM yyyy HH:mm")
                        </td>

                        <td>
                            @(sync.CompletedOn?.ToString("dd MMM yyyy HH:mm") ?? "-")
                        </td>

                        <td>

                            @if (sync.IsManual)
                            {
                                <span class="badge bg-primary">
                                    Manual
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Scheduled
                                </span>
                            }

                        </td>

                        <td>@sync.TotalRetrieved</td>

                        <td>@sync.TotalCompliant</td>

                        <td>@sync.TotalNonCompliant</td>

                        <td>@sync.CasesCreated</td>

                        <td>

                            @if (sync.Status == SyncStatus.Completed)
                            {
                                <span class="badge bg-success">
                                    Completed
                                </span>
                            }
                            else if (sync.Status == SyncStatus.Running)
                            {
                                <span class="badge bg-warning text-dark">
                                    Running
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Failed
                                </span>
                            }

                        </td>

                        <td>

                            <button class="btn btn-sm btn-cidb-submit-outline"
                                    @onclick="() => OpenSynchronization(sync.Id)">

                                <i class="bi bi-eye me-1"></i>

                                View

                            </button>

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

    <div class="text-center mb-2">

        <small class="text-muted">

            Showing @StartResult - @EndResult of @Result.TotalCount results

        </small>

    </div>

    @if (Result.TotalPages > 1)
    {
        <nav>

            <ul class="pagination justify-content-center">

                @if (Result.HasPreviousPage)
                {
                    <li class="page-item">

                        <button class="page-link"
                                @onclick="() => GoToPage(1)">

                            First

                        </button>

                    </li>
                }

                <li class="page-item @(Result.HasPreviousPage ? "" : "disabled")">

                    <button class="page-link"
                            @onclick="() => GoToPage(Result.PageNumber - 1)">

                        Previous

                    </button>

                </li>

                @foreach (var pageNumber in VisiblePages)
                {
                    <li class="page-item @(pageNumber == Result.PageNumber ? "active" : "")">

                        <button class="page-link"
                                @onclick="() => GoToPage(pageNumber)">

                            @pageNumber

                        </button>

                    </li>
                }

                <li class="page-item @(Result.HasNextPage ? "" : "disabled")">

                    <button class="page-link"
                            @onclick="() => GoToPage(Result.PageNumber + 1)">

                        Next

                    </button>

                </li>

                @if (Result.HasNextPage)
                {
                    <li class="page-item">

                        <button class="page-link"
                                @onclick="() => GoToPage(Result.TotalPages)">

                            Last

                        </button>

                    </li>
                }

            </ul>

        </nav>
    }
}

@if (ShowSyncDetailModal && SelectedSynchronization != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color:rgba(0,0,0,.5)">

        <div class="modal-dialog modal-xl modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        <i class="bi bi-clock-history me-2"></i>
                        Synchronization Details
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseSynchronization">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="row g-3 mb-4">

                        <div class="col-md-3">

                            <div class="border rounded p-3">

                                <small class="text-muted d-block">
                                    Started
                                </small>

                                <strong>
                                    @SelectedSynchronization.StartedOn.ToString("dd MMM yyyy HH:mm")
                                </strong>

                            </div>

                        </div>

                        <div class="col-md-3">

                            <div class="border rounded p-3">

                                <small class="text-muted d-block">
                                    Completed
                                </small>

                                <strong>
                                    @(SelectedSynchronization.CompletedOn?.ToString("dd MMM yyyy HH:mm") ?? "-")
                                </strong>

                            </div>

                        </div>

                        <div class="col-md-2">

                            <div class="border rounded p-3 text-center">

                                <small class="text-muted d-block">
                                    Retrieved
                                </small>

                                <h4 class="mb-0">
                                    @SelectedSynchronization.TotalRetrieved
                                </h4>

                            </div>

                        </div>

                        <div class="col-md-2">

                            <div class="border rounded p-3 text-center">

                                <small class="text-muted d-block">
                                    Cases
                                </small>

                                <h4 class="mb-0">
                                    @SelectedSynchronization.CasesCreated
                                </h4>

                            </div>

                        </div>

                        <div class="col-md-2">

                            <div class="border rounded p-3 text-center">

                                <small class="text-muted d-block">
                                    Errors
                                </small>

                                <h4 class="mb-0">
                                    @SelectedSynchronization.ErrorCount
                                </h4>

                            </div>

                        </div>

                    </div>

                    <hr />

                    <h6 class="mb-3">
                        Synchronization Timeline
                    </h6>

                    @if (SelectedSynchronization.Logs.Any())
                    {
                        @foreach (var log in SelectedSynchronization.Logs)
                        {
                            <div class="d-flex mb-4 px-4">

                                <div class="me-3">

                                    @switch (log.Level)
                                    {
                                        case SyncLogLevel.Information:

                                            <i class="bi bi-info-circle-fill text-primary fs-5"></i>

                                            break;

                                        case SyncLogLevel.Warning:

                                            <i class="bi bi-exclamation-circle-fill text-warning fs-5"></i>

                                            break;

                                        case SyncLogLevel.Error:

                                            <i class="bi bi-x-circle-fill text-danger fs-5"></i>

                                            break;
                                    }

                                </div>

                                <div class="flex-grow-1 border-start ps-3">

                                    <div class="d-flex justify-content-between">

                                        <strong>
                                            @log.Title
                                        </strong>

                                        <small class="text-muted">
                                            @log.Date.ToString("dd MMM yyyy HH:mm:ss")
                                        </small>

                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(log.TenderNumber))
                                    {
                                        <div class="text-primary fw-semibold mt-1">
                                            @log.TenderNumber
                                        </div>
                                    }

                                    <div class="mt-1">
                                        @log.Message
                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">

                            <i class="bi bi-clock-history fs-1"></i>

                            <p class="mt-3 mb-0">
                                No synchronization logs were recorded.
                            </p>

                        </div>
                    }

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            @onclick="CloseSynchronization">
                        <i class="bi bi-x-circle me-2"></i>
                        Close
                    </button>

                </div>

            </div>

        </div>

    </div>
}


@code {

    private bool ShowSyncDetailModal;

    private TenderSyncDetailModel? SelectedSynchronization;

    private TenderSyncSearchModel Search = new()
    {
        PageNumber = 1,
        PageSize = 10
    };

    private PagedResult<TenderSync>? Result;

    protected override async Task OnInitializedAsync()
    {
        await LoadSynchronizations();
    }

    private async Task LoadSynchronizations()
    {
        Result = await TenderSyncRepository.SearchAsync(Search);
    }

    private async Task SearchSynchronizations()
    {
        Search.PageNumber = 1;

        await LoadSynchronizations();
    }

    private async Task ResetFilters()
    {
        Search = new TenderSyncSearchModel
        {
            PageNumber = 1,
            PageSize = 10
        };

        await LoadSynchronizations();
    }

    private async Task GoToPage(int page)
    {
        if (Result == null)
            return;

        page = Math.Max(1, Math.Min(page, Result.TotalPages));

        Search.PageNumber = page;

        await LoadSynchronizations();
    }

    private async Task OpenSynchronization(Guid id)
    {
        SelectedSynchronization =
            await LogRepository.GetDetailAsync(id);

        ShowSyncDetailModal = true;
    }

    private void CloseSynchronization()
    {
        ShowSyncDetailModal = false;

        SelectedSynchronization = null;
    }

    private IEnumerable<int> VisiblePages
    {
        get
        {
            if (Result == null)
                return Enumerable.Empty<int>();

            const int maxPages = 5;

            int start = Math.Max(1, Result.PageNumber - 2);
            int end = Math.Min(Result.TotalPages, start + maxPages - 1);

            if (end - start < maxPages - 1)
            {
                start = Math.Max(1, end - maxPages + 1);
            }

            return Enumerable.Range(start, end - start + 1);
        }
    }

    private int StartResult =>
        Result == null || Result.TotalCount == 0
            ? 0
            : ((Result.PageNumber - 1) * Result.PageSize) + 1;

    private int EndResult =>
        Result == null
            ? 0
            : Math.Min(Result.PageNumber * Result.PageSize, Result.TotalCount);

}
