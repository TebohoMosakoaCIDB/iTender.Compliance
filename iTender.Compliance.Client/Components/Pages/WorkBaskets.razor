@page "/work-baskets"
@rendermode InteractiveServer

@using iTender.Compliance.Application.Interfaces.Services
@using iTender.Compliance.Domain.Entities
@using iTender.Compliance.Domain.Enums
@using iTender.Compliance.Client.Helpers
@using Microsoft.AspNetCore.Authorization

@inject IWorkBasketService WorkBasketService
@inject ICaseAuthorizationService CaseAuthorizationService
@inject NavigationManager Navigation

@attribute [Authorize(Policy = "CaseManagement")]

<PageTitle>Work Baskets | CRCIP Monitor</PageTitle>

<div class="mb-4">
    <h2 class="mb-4">
        <i class="bi bi-inboxes-fill me-2 text-secondary"></i>
        Work Baskets
    </h2>
    <small class="text-muted">
        Queues of compliance cases grouped by the stage they're at.
    </small>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">

    <div class="btn-group" role="group">

        <button class="btn btn-sm @(_scope == "Mine" ? "btn-cidb-submit" : "btn-cidb-submit-outline")"
                @onclick='() => ChangeScopeAsync("Mine")'>
            <i class="bi bi-person me-1"></i>
            My Baskets
        </button>

        <button class="btn btn-sm @(_scope == "All" ? "btn-cidb-submit" : "btn-cidb-submit-outline")"
                @onclick='() => ChangeScopeAsync("All")'
                disabled="@(!_canViewAll)">
            <i class="bi bi-people me-1"></i>
            Team Baskets
        </button>

    </div>

    @if (!_canViewAll)
    {
        <small class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            You are viewing your own baskets.
        </small>
    }

</div>

<ul class="nav nav-tabs mb-4">

    @foreach (var basket in Enum.GetValues<WorkBasket>())
    {
        var isActive = basket == _selectedBasket;
        var count = _counts.TryGetValue(basket, out var c) ? c : 0;

        <li class="nav-item">
            <button class="nav-link @(isActive ? "active" : "")"
                    @onclick="() => SelectBasket(basket)">
                @GetBasketLabel(basket)
                @if (count > 0)
                {
                    <span class="badge @(isActive ? "bg-light text-dark" : "bg-secondary") ms-1">
                        @count
                    </span>
                }
            </button>
        </li>
    }

</ul>

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-danger"></div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@GetBasketLabel(_selectedBasket)</strong>
            <span class="badge bg-secondary">@_cases.Count</span>
        </div>

        <div class="card-body p-0">
            @if (!_cases.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-check-circle display-5 text-success"></i>
                    <p class="mt-3 mb-0">Nothing in this basket.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light table-header-brand">
                            <tr>
                                <th>Tender</th>
                                <th>Employer</th>
                                <th>Status</th>
                                <th>Findings</th>
                                <th>Latest Response</th>
                                <th>Submitted On</th>
                                <th>Review / Resubmission Due</th>
                                <th>Agent</th>
                                <th>Age</th>
                                <th>Response Due</th>
                                @if (_selectedBasket == WorkBasket.ReferralPending)
                                {
                                    <th>Days Awaiting</th>
                                }
                                <th style="width:100px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _cases)
                            {
                                var openFindings = item.ComplianceFindings?.Count(f => !f.IsResolved) ?? 0;
                                var age = (DateTime.UtcNow - item.CreatedOn).Days;

                                var latestResponse = item.ClientResponses?
                                    .OrderByDescending(r => r.SubmittedOn)
                                    .FirstOrDefault();

                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @(item.Tender?.TenderNumber ?? "-")
                                        </div>
                                        <small class="text-muted">
                                            @item.Tender?.Title
                                        </small>
                                    </td>
                                    <td>@item.Tender?.EmployerName</td>
                                    <td>@item.Status.ToDisplayName()</td>
                                    <td>
                                        @if (openFindings > 0)
                                        {
                                            <span class="badge bg-danger">@openFindings open</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">0</span>
                                        }
                                    </td>
                                    @* Latest client response status *@
                                    <td>
                                        @if (latestResponse == null)
                                        {
                                            <span class="text-muted">No response</span>
                                        }
                                        else
                                        {
                                            <span class="badge @GetResponseStatusClass(latestResponse.Status)">
                                                @GetResponseStatusLabel(latestResponse.Status)
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(latestResponse.ReviewComments))
                                            {
                                                <div class="small text-muted mt-1"
                                                     title="@latestResponse.ReviewComments">
                                                    Review comments available
                                                </div>
                                            }
                                        }
                                    </td>

                                    @* Latest response submission date *@
                                    <td>
                                        @if (latestResponse == null)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            <span>@latestResponse.SubmittedOn.ToString("dd MMM yyyy")</span>
                                            <div class="small text-muted">
                                                @latestResponse.SubmittedOn.ToString("HH:mm")
                                            </div>
                                        }
                                    </td>

                                    @* Additional information / resubmission deadline *@
                                    <td>
                                        @if (latestResponse?.InformationRequestDueOn is DateTime responseDeadline)
                                        {
                                            var isOverdue = responseDeadline < DateTime.UtcNow;
                                            var daysRemaining = (responseDeadline - DateTime.UtcNow).TotalDays;

                                            <span class="badge @(isOverdue ? "bg-danger" : daysRemaining <= 2 ? "bg-warning text-dark" : "bg-secondary")">
                                                @(isOverdue ? "Overdue" : $"{Math.Ceiling(daysRemaining)} day(s) left")
                                            </span>

                                            <div class="small text-muted">
                                                @responseDeadline.ToString("dd MMM yyyy HH:mm")
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@(item.Agent?.FullName ?? "-")</td>
                                    <td>
                                        <span class="badge @(age > 25 ? "bg-danger" : age > 15 ? "bg-warning text-dark" : "bg-secondary")">
                                            @age day(s)
                                        </span>
                                    </td>
                                    <td>
                                        @{
                                            var nearestDue = item.CaseLetters?
                                                .Where(l => l.RespondedOn == null && l.ResponseDueOn > DateTime.UtcNow)
                                                .OrderBy(l => l.ResponseDueOn)
                                                .FirstOrDefault();

                                            var overdue = item.CaseLetters?
                                                .Where(l => l.RespondedOn == null && l.ResponseDueOn <= DateTime.UtcNow)
                                                .OrderByDescending(l => l.ResponseDueOn)
                                                .FirstOrDefault();

                                            var responseToShow = overdue ?? nearestDue;
                                        }

                                        @if (responseToShow is null)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            var isOverdue = responseToShow.ResponseDueOn <= DateTime.UtcNow;
                                            var daysLeft = (responseToShow.ResponseDueOn - DateTime.UtcNow).TotalDays;

                                            <span class="badge @(isOverdue ? "bg-danger" : daysLeft < 2 ? "bg-warning text-dark" : "bg-secondary")">
                                                @(isOverdue ? "Overdue" : $"{Math.Max(0, (int)daysLeft)} d")
                                            </span>

                                            <div class="text-muted small">
                                                @responseToShow.ResponseDueOn.ToString("dd MMM HH:mm")
                                            </div>
                                        }
                                    </td>

                                    @if (_selectedBasket == WorkBasket.ReferralPending)
                                    {
                                        var overdueLetter = item.CaseLetters?
                                            .Where(l => l.RespondedOn == null && l.ResponseDueOn <= DateTime.UtcNow)
                                            .OrderBy(l => l.ResponseDueOn)
                                            .FirstOrDefault();

                                        var daysAwaiting = overdueLetter is null
                                            ? 0
                                            : (DateTime.UtcNow - overdueLetter.ResponseDueOn).Days;

                                        <td>
                                            <span class="badge bg-danger">@daysAwaiting day(s)</span>
                                        </td>
                                    }

                                    <td>
                                        <button class="btn btn-sm btn-cidb-submit"
                                                @onclick="() => OpenCase(item.Id)">
                                            <i class="bi bi-folder2-open me-1"></i>
                                            Open
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private WorkBasket _selectedBasket = WorkBasket.NewlyIdentified;
    private List<ComplianceCase> _cases = new();
    private Dictionary<WorkBasket, int> _counts = new();
    private bool _loading = true;
    private Guid? _agentFilter;
    private Guid? _currentAgentId;
    private string _scope = "Mine";
    private bool _canViewAll;

    protected override async Task OnInitializedAsync()
    {
        _canViewAll = await CaseAuthorizationService.CanViewAllCasesAsync();
        _currentAgentId = await CaseAuthorizationService.GetCurrentAgentIdAsync();

        _scope = "Mine";

        RecomputeFilter();

        await RefreshAsync();
    }

    private async Task ChangeScopeAsync(string scope)
    {
        _scope = scope;
        RecomputeFilter();
        await RefreshAsync();
    }

    private static string GetResponseStatusLabel(ClientResponseStatus status)
    {
        return status switch
        {
            ClientResponseStatus.Received => "Received",
            ClientResponseStatus.UnderReview => "Under Review",
            ClientResponseStatus.AdditionalInformationRequested =>
                "Additional Information Requested",
            ClientResponseStatus.Incomplete => "Incomplete",
            ClientResponseStatus.Resubmitted => "Resubmitted",
            ClientResponseStatus.Accepted => "Accepted",
            ClientResponseStatus.Rejected => "Rejected",
            _ => status.ToString()
        };
    }

    private static string GetResponseStatusClass(ClientResponseStatus status)
    {
        return status switch
        {
            ClientResponseStatus.Received => "bg-primary",
            ClientResponseStatus.Resubmitted => "bg-info text-dark",
            ClientResponseStatus.UnderReview => "bg-warning text-dark",
            ClientResponseStatus.AdditionalInformationRequested => "bg-warning text-dark",
            ClientResponseStatus.Incomplete => "bg-danger",
            ClientResponseStatus.Accepted => "bg-success",
            ClientResponseStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private void RecomputeFilter()
    {
        if (_scope == "Mine")
        {
            _agentFilter = _currentAgentId;
        }
        else if (_canViewAll)
        {
            _agentFilter = null;
        }
        else
        {
            // Non-manager trying to see "All" - fall back to Mine.
            _agentFilter = _currentAgentId;
            _scope = "Mine";
        }
    }

    private async Task SelectBasket(WorkBasket basket)
    {
        _selectedBasket = basket;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _loading = true;

        try
        {
            _counts = await WorkBasketService.GetCountsAsync(_agentFilter);
            _cases = (await WorkBasketService.GetCasesAsync(_selectedBasket, _agentFilter)).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCase(Guid caseId)
    {
        Navigation.NavigateTo($"/cases/{caseId}");
    }

    private static string GetBasketLabel(WorkBasket basket) =>
        basket switch
        {
            WorkBasket.NewlyIdentified => "Newly Identified",
            WorkBasket.VerificationRequired => "Verification Required",
            WorkBasket.NotAdvertised => "Not Advertised",
            WorkBasket.DueForInstructionLetter => "Due for IL",
            WorkBasket.DueForContraventionNotice => "Due for CN",
            WorkBasket.CorrectiveAction => "Corrective Action",
            WorkBasket.NonCompliant => "Non-Compliant",
            WorkBasket.Referral => "Referral",
            WorkBasket.ClearedResolved => "Cleared / Resolved",
            WorkBasket.ReferralPending => "Referral Pending",
            WorkBasket.AwaitingInstructionalResponse => "Awaiting IL Response",
            _ => basket.ToString()
        };
}