    private string GetPriorityClass(CasePriority priority)
    {
        return priority switch
        {
            CasePriority.High => "bg-danger",

            CasePriority.Normal => "bg-warning text-dark",

            CasePriority.Low => "bg-success",

            _ => "bg-secondary"
        };
    }

