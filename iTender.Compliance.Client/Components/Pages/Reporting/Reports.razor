    private async Task RefreshReport()
    {
        if (_fromDate > _toDate)
            return;

        _isLoading = true;

        try
        {
            var fromDate = _fromDate.Date;
            var toDate = _toDate.Date.AddDays(1).AddTicks(-1);

            _reportSummary = await ReportService.GetReportAsync(fromDate, toDate);
            _nonCompliantTenders = await ReportService.GetNonCompliantTendersAsync(fromDate, toDate);
            _lateRopRegistrations = (await ReportingService.GetLateRopRegistrationsAsync(fromDate, toDate)).ToList();

            if (_selectedReportType == "Monthly2")
            {
                _monthlyReport = await ReportingService
                    .GetMonthlyReportAsync(_fromDate.Year, _fromDate.Month);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

