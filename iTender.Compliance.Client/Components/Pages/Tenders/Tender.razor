@page "/tenders/{Id:guid}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using iTender.Compliance.Application.DTOs
@using iTender.Compliance.Application.Interfaces.Services
@using iTender.Compliance.Domain.Enums

@attribute [Authorize]

@inject ITenderService TenderService
@inject NavigationManager Navigation

<PageTitle>Tenders | CRCIP Monitor</PageTitle>

@if (_loading)
{
    <div class="text-center py-5">

        <div class="spinner-border text-primary"></div>

        <div class="mt-3 text-muted">
            Loading tender...
        </div>

    </div>
}
else if (Model == null)
{
    <div class="alert alert-danger">
        Tender could not be found.
    </div>
}
else
{
    <div class="container-fluid">

        <!-- HEADER -->

        <div class="d-flex justify-content-between align-items-start mb-4">

            <div>

                <div class="text-muted small mb-1">
                    Tender
                </div>

                <h2 class="mb-1">
                    @Model.TenderNumber
                </h2>

                <div class="text-muted">
                    @Model.Title
                </div>

            </div>

            <div class="d-flex gap-2">

                @if (!string.IsNullOrWhiteSpace(Model.TenderUrl))
                {
                    <a href="@Model.TenderUrl"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-sm btn-cidb-submit-outline">

                        <i class="bi bi-box-arrow-up-right me-1"></i>

                        View Tender

                    </a>
                }

                @if (Model.ComplianceCaseId.HasValue)
                {
                    <button class="btn btn-sm btn-cidb-submit"
                    @onclick="OpenCase">

                        <i class="bi bi-shield-check me-1"></i>

                        View Compliance Case

                    </button>
                }

            </div>

        </div>


        <!-- TENDER INFORMATION -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">
                    Tender Information
                </h5>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Tender Number
                        </label>

                        <div class="fw-semibold">
                            @Model.TenderNumber
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Title
                        </label>

                        <div class="fw-semibold">
                            @Model.Title
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Employer
                        </label>

                        <div>
                            @Model.EmployerName
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Source
                        </label>

                        <div>
                            @Model.Source
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Advertised
                        </label>

                        <div>
                            @Model.AdvertisedDate.ToString("dd MMMM yyyy")
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Closing Date
                        </label>

                        <div>
                            @Model.ClosingDate.ToString("dd MMMM yyyy HH:mm")
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Class of Works
                        </label>

                        <div>
                            @(
                                                    string.IsNullOrWhiteSpace(Model.ClassOfWorks)
                                                                        ? "Not specified"
                                                                        : Model.ClassOfWorks
                                        )
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <label class="text-muted small">
                                        Construction Tender
                                    </label>

                                    <div>

                                        @if (Model.IsConstruction)
                            {
                                <span class="badge bg-success">
                                    Yes
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    No
                                </span>
                            }

                        </div>

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr />

                    <label class="text-muted small">
                        Description
                    </label>

                    <div class="mt-1">
                        @Model.Description
                    </div>
                }

            </div>

        </div>


        <!-- eTENDERS INFORMATION -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">
                    eTenders Information
                </h5>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Procurement Category
                        </label>

                        <div class="fw-semibold">
                            @(
                                                    string.IsNullOrWhiteSpace(Model.ProcurementCategory)
                                                                        ? "Not specified"
                                                                        : Model.ProcurementCategory
                                        )
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <label class="text-muted small">
                                        Province
                                    </label>

                                    <div>
                                        @(
                                                    string.IsNullOrWhiteSpace(Model.Province)
                                                                        ? "Not specified"
                                                                        : Model.Province
                                        )
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <label class="text-muted small">
                                        Tender Status
                                    </label>

                                    <div>
                                        @if (string.IsNullOrWhiteSpace(Model.TenderStatus))
                            {
                                <span class="text-muted">
                                    Not specified
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">
                                    @Model.TenderStatus
                                </span>
                            }
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Procurement Method
                        </label>

                        <div>
                            @(
                                                    string.IsNullOrWhiteSpace(Model.ProcurementMethod)
                                                                        ? "Not specified"
                                                                        : Model.ProcurementMethod
                                        )
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <label class="text-muted small">
                                        Procurement Method Details
                                    </label>

                                    <div>
                                        @(
                                                    string.IsNullOrWhiteSpace(Model.ProcurementMethodDetails)
                                                                        ? "Not specified"
                                                                        : Model.ProcurementMethodDetails
                                        )
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <label class="text-muted small">
                                        eTenders Tender ID
                                    </label>

                                    <div>
                                        @(
                                                    string.IsNullOrWhiteSpace(Model.ExternalId)
                                                                        ? "Not available"
                                                                        : Model.ExternalId
                                        )
                                    </div>

                                </div>

                                <div class="col-md-12">

                                    <label class="text-muted small">
                                        OCID
                                    </label>

                                    <div class="text-break">
                                        @(
                                                    string.IsNullOrWhiteSpace(Model.Ocid)
                                                                        ? "Not available"
                                                                        : Model.Ocid
                                        )
                                    </div>

                                </div>

                                <div class="col-md-12">

                                    <label class="text-muted small">
                                        Delivery Location
                                    </label>

                                    <div>
                                        @(
                                                    string.IsNullOrWhiteSpace(Model.DeliveryLocation)
                                                                        ? "Not specified"
                                                                        : Model.DeliveryLocation
                                        )
                                    </div>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.SpecialConditions))
                    {
                        <div class="col-md-12">

                            <label class="text-muted small">
                                Special Conditions
                            </label>

                            <div class="mt-1">
                                @Model.SpecialConditions
                            </div>

                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.SourceDocumentUrl))
                    {
                        <div class="col-md-12">

                            <hr />

                            <a href="@Model.SourceDocumentUrl"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-sm btn-cidb-submit-outline">

                                <i class="bi bi-file-earmark-text me-1"></i>

                                View Source Document

                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- CONTACT -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">
                    Contact Information
                </h5>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-4">

                        <label class="text-muted small">
                            Contact Name
                        </label>

                        <div>
                            @(
                                                    string.IsNullOrWhiteSpace(Model.ContactName)
                                                                        ? "Not provided"
                                                                        : Model.ContactName
                                        )
                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <label class="text-muted small">
                                        Email
                                    </label>

                                    <div>
                                        @if (string.IsNullOrWhiteSpace(Model.ContactEmail))
                            {
                                <span>
                                    Not provided
                                </span>
                            }
                            else
                            {
                                <a href="mailto:@Model.ContactEmail">
                                    @Model.ContactEmail
                                </a>
                            }
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="text-muted small">
                            Contact Number
                        </label>

                        <div>
                            @if (string.IsNullOrWhiteSpace(Model.ContactNumber))
                            {
                                <span>
                                    Not provided
                                </span>
                            }
                            else
                            {
                                <a href="tel:@Model.ContactNumber">
                                    @Model.ContactNumber
                                </a>
                            }
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- AWARD / ROP -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">
                    Award & RoP Information
                </h5>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-4">

                        <label class="text-muted small">
                            Awarded Date
                        </label>

                        <div>
                            @(
                                                    Model.AwardedDate?.ToString("dd MMMM yyyy")
                                                                        ?? "Not awarded"
                                        )
                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <label class="text-muted small">
                                        Award Value
                                    </label>

                                    <div>
                                        @(
                                                    Model.AwardValue.HasValue
                                                                        ? Model.AwardValue.Value.ToString("C")
                                                                        : "Not available"
                                        )
                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <label class="text-muted small">
                                        Winning Contractor
                                    </label>

                                    <div>
                                        @(
                                                    string.IsNullOrWhiteSpace(Model.WinningContractor)
                                                                        ? "Not available"
                                                                        : Model.WinningContractor
                                        )
                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <label class="text-muted small">
                                        Registered on RoP
                                    </label>

                                    <div>

                                        @if (Model.IsRegisteredOnRoP)
                            {
                                <span class="badge bg-success">
                                    Registered
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Not Registered
                                </span>
                            }

                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="text-muted small">
                            RoP Registration Date
                        </label>

                        <div>
                            @(
                                                    Model.RoPRegistrationDate?
                                                                        .ToString("dd MMMM yyyy")
                                                                        ?? "Not registered"
                                        )
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- SYNC -->

        @if (Model.TenderSync != null)
        {
            <div class="card shadow-sm mb-4">

                <div class="card-header">

                    <h5 class="mb-0">
                        Tender Synchronisation
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row g-4 mb-4">

                        <div class="col-md-3">

                            <label class="text-muted small">
                                Status
                            </label>

                            <div>
                                @GetSyncStatus(Model.TenderSync.Status)
                            </div>

                        </div>

                        <div class="col-md-3">

                            <label class="text-muted small">
                                Started
                            </label>

                            <div>
                                @Model.TenderSync.StartedOn.ToString("dd MMM yyyy HH:mm")
                            </div>

                        </div>

                        <div class="col-md-3">

                            <label class="text-muted small">
                                Completed
                            </label>

                            <div>
                                @(
                                                        Model.TenderSync.CompletedOn?
                                                                                    .ToString("dd MMM yyyy HH:mm")
                                                                                    ?? "Running"
                                            )
                                        </div>

                                    </div>

                                    <div class="col-md-3">

                                        <label class="text-muted small">
                                            Sync Type
                                        </label>

                                        <div>
                                            @(
                                                        Model.TenderSync.IsManual
                                                                                    ? "Manual"
                                                                                    : "Scheduled"
                                            )
                                        </div>

                                    </div>

                                </div>


                                <div class="row g-3">

                                    <div class="col-md-3">

                                        <div class="border rounded p-3">

                                            <div class="text-muted small">
                                                Retrieved
                                            </div>

                                            <div class="fs-4 fw-semibold">
                                                @Model.TenderSync.TotalRetrieved
                                            </div>

                                        </div>

                                    </div>

                                    <div class="col-md-3">

                                        <div class="border rounded p-3">

                                            <div class="text-muted small">
                                                Compliant
                                            </div>

                                            <div class="fs-4 fw-semibold text-success">
                                                @Model.TenderSync.TotalCompliant
                                            </div>

                                        </div>

                                    </div>

                                    <div class="col-md-3">

                                        <div class="border rounded p-3">

                                            <div class="text-muted small">
                                                Non-Compliant
                                            </div>

                                            <div class="fs-4 fw-semibold text-danger">
                                                @Model.TenderSync.TotalNonCompliant
                                            </div>

                                        </div>

                                    </div>

                                    <div class="col-md-3">

                                        <div class="border rounded p-3">

                                            <div class="text-muted small">
                                                Cases Created
                                            </div>

                                            <div class="fs-4 fw-semibold">
                                                @Model.TenderSync.CasesCreated
                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
        }

    </div>
}
@code {

    [Parameter]
    public Guid Id { get; set; }

    private TenderDetailModelDto? Model;

    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Model =
                await TenderService.GetDetailAsync(Id);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCase()
    {
        if (Model?.ComplianceCaseId.HasValue == true)
        {
            Navigation.NavigateTo(
                $"/cases/{Model.ComplianceCaseId.Value}");
        }
    }

    private static string DisplayValue(string? value) { return string.IsNullOrWhiteSpace(value) ? "Not provided" : value; }

    private static MarkupString GetSyncStatus(
        SyncStatus status)
    {
        var html = status switch
        {
            SyncStatus.Pending =>
                "<span class='badge bg-secondary'>Pending</span>",

            SyncStatus.Running =>
                "<span class='badge bg-primary'>Running</span>",

            SyncStatus.Completed =>
                "<span class='badge bg-success'>Completed</span>",

            SyncStatus.Failed =>
                "<span class='badge bg-danger'>Failed</span>",

            _ =>
                "<span class='badge bg-secondary'>Unknown</span>"
        };

        return new MarkupString(html);
    }
}