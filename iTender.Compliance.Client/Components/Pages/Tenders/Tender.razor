@page "/tenders/{Id:guid}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using iTender.Compliance.Application.DTOs
@using iTender.Compliance.Application.Interfaces.Services
@using iTender.Compliance.Domain.Enums

@attribute [Authorize]

@inject ITenderService TenderService
@inject NavigationManager Navigation

<PageTitle>Tenders | CRCIP Monitor</PageTitle>

@if (_loading)
{
    <div class="text-center py-5">

        <div class="spinner-border text-primary"></div>

        <div class="mt-3 text-muted">
            Loading tender...
        </div>

    </div>
}
else if (Model == null)
{
    <div class="alert alert-danger">
        Tender could not be found.
    </div>
}
else
{
    <div class="container-fluid">

        <!-- HEADER -->

        <div class="d-flex justify-content-between align-items-start mb-4">

            <div>

                <div class="text-muted small mb-1">
                    Tender
                </div>

                <h2 class="mb-1">
                    @Model.TenderNumber
                </h2>

                <div class="text-muted">
                    @Model.Title
                </div>

            </div>

            <div class="d-flex gap-2">

                @if (!string.IsNullOrWhiteSpace(Model.TenderUrl))
                {
                    <a href="@Model.TenderUrl"
                       target="_blank"
                       class="btn btn-sm btn-cidb-submit-outline">

                        <i class="bi bi-box-arrow-up-right me-1"></i>

                        View Tender

                    </a>
                }

                @if (Model.ComplianceCaseId.HasValue)
                {
                    <button class="btn btn-sm btn-cidb-submit"
                            @onclick="OpenCase">

                        <i class="bi bi-shield-check me-1"></i>

                        View Compliance Case

                    </button>
                }

            </div>

        </div>


        <!-- TENDER INFORMATION -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">
                    Tender Information
                </h5>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Tender Number
                        </label>

                        <div class="fw-semibold">
                            @Model.TenderNumber
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Title
                        </label>

                        <div class="fw-semibold">
                            @Model.Title
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Employer
                        </label>

                        <div>
                            @Model.EmployerName
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Source
                        </label>

                        <div>
                            @Model.Source
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Advertised
                        </label>

                        <div>
                            @Model.AdvertisedDate.ToString("dd MMMM yyyy")
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Closing Date
                        </label>

                        <div>
                            @Model.ClosingDate.ToString("dd MMMM yyyy HH:mm")
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Class of Works
                        </label>

                        <div>
                            @(string.IsNullOrWhiteSpace(Model.ClassOfWorks)
                                ? "Not specified"
                                : Model.ClassOfWorks)
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="text-muted small">
                            Construction Tender
                        </label>

                        <div>

                            @if (Model.IsConstruction)
                            {
                                <span class="badge bg-success">
                                    Yes
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    No
                                </span>
                            }

                        </div>

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr />

                    <label class="text-muted small">
                        Description
                    </label>

                    <div class="mt-1">
                        @Model.Description
                    </div>
                }

            </div>

        </div>


        <!-- CONTACT -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">
                    Contact Information
                </h5>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-4">

                        <label class="text-muted small">
                            Contact Name
                        </label>

                        <div>
                            @(Model.ContactName ?? "Not provided")
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="text-muted small">
                            Email
                        </label>

                        <div>
                            @(Model.ContactEmail ?? "Not provided")
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="text-muted small">
                            Contact Number
                        </label>

                        <div>
                            @(Model.ContactNumber ?? "Not provided")
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- AWARD / ROP -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <h5 class="mb-0">
                    Award & RoP Information
                </h5>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-4">

                        <label class="text-muted small">
                            Awarded Date
                        </label>

                        <div>
                            @(Model.AwardedDate?.ToString("dd MMMM yyyy")
                                ?? "Not awarded")
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="text-muted small">
                            Award Value
                        </label>

                        <div>
                            @(Model.AwardValue.HasValue
                                ? Model.AwardValue.Value.ToString("C")
                                : "Not available")
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="text-muted small">
                            Winning Contractor
                        </label>

                        <div>
                            @(Model.WinningContractor ?? "Not available")
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="text-muted small">
                            Registered on RoP
                        </label>

                        <div>

                            @if (Model.IsRegisteredOnRoP)
                            {
                                <span class="badge bg-success">
                                    Registered
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Not Registered
                                </span>
                            }

                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="text-muted small">
                            RoP Registration Date
                        </label>

                        <div>
                            @(Model.RoPRegistrationDate?
                                .ToString("dd MMMM yyyy")
                                ?? "Not registered")
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- SYNC -->
        @if (Model.TenderSync != null)
        {
            <div class="card shadow-sm mb-4">

                <div class="card-header">

                    <h5 class="mb-0">
                        Tender Synchronisation
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row g-4 mb-4">

                        <div class="col-md-3">

                            <label class="text-muted small">
                                Status
                            </label>

                            <div>
                                @GetSyncStatus(Model.TenderSync.Status)
                            </div>

                        </div>

                        <div class="col-md-3">

                            <label class="text-muted small">
                                Started
                            </label>

                            <div>
                                @Model.TenderSync.StartedOn
                                .ToString("dd MMM yyyy HH:mm")
                            </div>

                        </div>

                        <div class="col-md-3">

                            <label class="text-muted small">
                                Completed
                            </label>

                            <div>
                                @(Model.TenderSync.CompletedOn?
                                    .ToString("dd MMM yyyy HH:mm")
                                    ?? "Running")
                            </div>

                        </div>

                        <div class="col-md-3">

                            <label class="text-muted small">
                                Sync Type
                            </label>

                            <div>
                                @(Model.TenderSync.IsManual
                                    ? "Manual"
                                    : "Scheduled")
                            </div>

                        </div>

                    </div>


                    <div class="row g-3">

                        <div class="col-md-3">
                            <div class="border rounded p-3">
                                <div class="text-muted small">
                                    Retrieved
                                </div>
                                <div class="fs-4 fw-semibold">
                                    @Model.TenderSync.TotalRetrieved
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="border rounded p-3">
                                <div class="text-muted small">
                                    Compliant
                                </div>
                                <div class="fs-4 fw-semibold text-success">
                                    @Model.TenderSync.TotalCompliant
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="border rounded p-3">
                                <div class="text-muted small">
                                    Non-Compliant
                                </div>
                                <div class="fs-4 fw-semibold text-danger">
                                    @Model.TenderSync.TotalNonCompliant
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="border rounded p-3">
                                <div class="text-muted small">
                                    Cases Created
                                </div>
                                <div class="fs-4 fw-semibold">
                                    @Model.TenderSync.CasesCreated
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

            </div>
        }


        <!-- SYNC LOG -->
        @if (Model.TenderSync?.Logs.Any() == true)
        {
            <div class="card shadow-sm mb-4">

                <div class="card-header">

                    <h5 class="mb-0">
                        Synchronisation Log
                    </h5>

                </div>

                <div class="card-body p-0">

                    <table class="table table-hover mb-0">

                        <thead>

                            <tr>
                                <th>Date</th>
                                <th>Level</th>
                                <th>Title</th>
                                <th>Message</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var log in Model.TenderSync.Logs)
                            {
                                <tr>

                                    <td>
                                        @log.Date.ToString("dd MMM yyyy HH:mm")
                                    </td>

                                    <td>
                                        @log.Level
                                    </td>

                                    <td>
                                        <strong>
                                            @log.Title
                                        </strong>
                                    </td>

                                    <td>
                                        @log.Message
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }

    </div>
}

@code {

    [Parameter]
    public Guid Id { get; set; }

    private TenderDetailModelDto? Model;

    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Model =
                await TenderService.GetDetailAsync(Id);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCase()
    {
        if (Model?.ComplianceCaseId.HasValue == true)
        {
            Navigation.NavigateTo(
                $"/cases/{Model.ComplianceCaseId.Value}");
        }
    }

    private static MarkupString GetSyncStatus(
        SyncStatus status)
    {
        var html = status switch
        {
            SyncStatus.Pending =>
                "<span class='badge bg-secondary'>Pending</span>",

            SyncStatus.Running =>
                "<span class='badge bg-primary'>Running</span>",

            SyncStatus.Completed =>
                "<span class='badge bg-success'>Completed</span>",

            SyncStatus.Failed =>
                "<span class='badge bg-danger'>Failed</span>",

            _ =>
                "<span class='badge bg-secondary'>Unknown</span>"
        };

        return new MarkupString(html);
    }
}