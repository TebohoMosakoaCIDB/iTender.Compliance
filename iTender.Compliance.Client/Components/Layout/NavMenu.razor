@implements IDisposable
@using iTender.Compliance.Application.Interfaces.Services
@using iTender.Compliance.Application.Interfaces.Repositories
@inject ITenderRepository TenderRepository
@inject IOfficerScopeService OfficerScope

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="" hidden>
            iTender.Compliance.Client
        </a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <!-- Logo -->
        <div class="nav-item px-3 mb-3">
            <img src="/cidb-logo.png"
                 style="width:15em" />
        </div>
        <AuthorizeView Context="authContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="profile"
                             Match="NavLinkMatch.All">
                        <div class="me-2">
                            <i class="bi bi-person-circle fs-3 text-danger"></i>
                        </div>

                        <div style="line-height: 1.1;">
                            <div class="fw-semibold text-danger">
                                @authContext.User.Identity?.Name
                            </div>

                            <small class="text-danger">
                                @authContext.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                            </small>
                        </div>
                    </NavLink>
                </div>

                <!-- Dashboard -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href=""
                             Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu"></span>
                        Dashboard
                    </NavLink>
                </div>

                <!-- Client Groups -->
                <AuthorizeView Policy="CaseManagement">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="clients/groups">
                            <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span>
                            Client Groups
                        </NavLink>
                    </div>
                </AuthorizeView>

                <!-- Compliance Cases -->
                @* <AuthorizeView Policy="CaseManagement">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="cases">
                            <span class="bi bi-patch-check-fill-nav-menu"></span>
                            All Cases
                        </NavLink>
                    </div>
                </AuthorizeView> *@

                <!-- Work Baskets -->
                <AuthorizeView Policy="CaseManagement">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="work-baskets">
                            <span class="bi bi-inboxes-fill-nav-menu" aria-hidden="true"></span>
                            Work Baskets
                        </NavLink>
                    </div>
                </AuthorizeView>

                <!-- Compliance Case Review -->
                <AuthorizeView Policy="CaseManagement">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="tenders/classification">
                            <span class="bi bi-diagram-3-nav-menu" aria-hidden="true"></span>
                            Classification Review
                            @if (UnreviewedTenderCount > 0)
                            {
                                <span class="badge bg-danger nav-badge">@UnreviewedTenderCount</span>
                            }
                        </NavLink>
                    </div>
                </AuthorizeView>

                <!-- Reports -->
                <AuthorizeView Policy="Reporting">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link"
                                 href="reports">
                            <span class="bi bi-file-earmark-bar-graph-fill-nav-menu"
                                  aria-hidden="true"></span>
                            Reports
                        </NavLink>
                    </div>
                </AuthorizeView>

                <!-- Administration -->
                <AuthorizeView Policy="Administration">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link"
                                 href="administration">
                            <span class="bi bi-gear-fill-nav-menu"></span>
                            Administration
                        </NavLink>
                    </div>
                </AuthorizeView>

                <!-- Logout -->
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />

                        <input type="hidden"
                               name="ReturnUrl"
                               value="@currentUrl" />

                        <button type="submit"
                                class="nav-link">
                            <span class="bi bi-box-arrow-left-nav-menu"></span>
                            Logout
                        </button>
                    </form>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="Account/Login">
                        <span class="bi bi-box-arrow-in-right-nav-menu"></span>
                        Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

</div>

@code
{
    private string? currentUrl;
    private int UnreviewedTenderCount;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        var scope = await OfficerScope.GetCurrentOfficerScopeAsync();
        UnreviewedTenderCount = await TenderRepository
            .CountAwaitingClassificationReviewAsync(scope);

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private readonly SemaphoreSlim _countLock = new(1, 1);

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);

        // Wait for any previous count to finish. Skip if we can't get the lock immediately,
        // to avoid piling up handlers.
        if (!await _countLock.WaitAsync(0))
        {
            StateHasChanged();
            return;
        }

        try
        {
            var scope = await OfficerScope.GetCurrentOfficerScopeAsync();
            UnreviewedTenderCount = await TenderRepository
                .CountAwaitingClassificationReviewAsync(scope);
        }
        catch
        {
            // Never let a nav-count failure crash the layout.
        }
        finally
        {
            _countLock.Release();
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        _countLock.Dispose();
    }
}